---
import Layout from '../layouts/Layout.astro';
import { db, schema } from '../db';
import { eq, desc } from 'drizzle-orm';

export const prerender = false;

// Helpers y Tipos
interface TransactionViewItem {
  id: number;
  amount: number;
  amountFormatted: string;
  description: string;
  paymentMethod: string;
  categoryId: number;
  categoryName: string;
  categoryFilterKey: string;
  materialIcon: string;
  date: Date;
  dateKey: string;
  timeFormatted: string;
}

interface DayGroup {
  dateKey: string;
  displayDate: string;
  totalDay: number;
  items: TransactionViewItem[];
}

function getMaterialIcon(name: string): string {
  const n = (name || '').toLowerCase();
  if (n.includes('maestr')) return 'school';
  if (n.includes('deuda') || n.includes('préstamo')) return 'account_balance';
  if (n.includes('supermercado') || n.includes('alimento')) return 'shopping_cart';
  if (n.includes('gasolina') || n.includes('transporte')) return 'local_gas_station';
  if (n.includes('ocio') || n.includes('hormiga')) return 'sports_esports';
  if (n.includes('software') || n.includes('tecnología')) return 'laptop';
  return 'receipt_long';
}

function getFilterKey(name: string): string {
  const n = (name || '').toLowerCase();
  if (n.includes('maestr')) return 'maestria';
  if (n.includes('deuda') || n.includes('préstamo')) return 'deudas';
  if (n.includes('supermercado') || n.includes('alimento')) return 'supermercado';
  if (n.includes('gasolina') || n.includes('transporte')) return 'gasolina';
  if (n.includes('ocio') || n.includes('hormiga')) return 'ocio';
  if (n.includes('software')) return 'software';
  return 'otros';
}

const now = new Date();
const currentMonthName = now.toLocaleDateString('es-HN', { month: 'long', year: 'numeric' });
const capitalizedMonth = currentMonthName.charAt(0).toUpperCase() + currentMonthName.slice(1);

let allTransactions: TransactionViewItem[] = [];
let categoriesList: Array<{ id: number; name: string; filterKey: string }> = [];
let dbConnected = true;

try {
  const rawCats = await db.select().from(schema.categories);
  categoriesList = rawCats.map((c) => ({
    id: c.id,
    name: c.name,
    filterKey: getFilterKey(c.name),
  }));

  const rawTx = await db
    .select({
      id: schema.transactions.id,
      amount: schema.transactions.amount,
      description: schema.transactions.description,
      paymentMethod: schema.transactions.payment_method,
      date: schema.transactions.date,
      categoryId: schema.transactions.category_id,
      categoryName: schema.categories.name,
    })
    .from(schema.transactions)
    .leftJoin(schema.categories, eq(schema.transactions.category_id, schema.categories.id))
    .orderBy(desc(schema.transactions.date));

  allTransactions = rawTx.map((t) => {
    const txDate = new Date(t.date);
    const amountNum = parseFloat(t.amount || '0');
    const dateKey = txDate.toISOString().slice(0, 10);
    return {
      id: t.id,
      amount: amountNum,
      amountFormatted: amountNum.toLocaleString('es-HN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
      description: t.description || 'Gasto registrado',
      paymentMethod: t.paymentMethod || 'DEBITO_EFECTIVO',
      categoryId: t.categoryId,
      categoryName: t.categoryName || 'General',
      categoryFilterKey: getFilterKey(t.categoryName || ''),
      materialIcon: getMaterialIcon(t.categoryName || ''),
      date: txDate,
      dateKey,
      timeFormatted: txDate.toLocaleTimeString('es-HN', { hour: '2-digit', minute: '2-digit', hour12: false }),
    };
  });
} catch (e) {
  console.error('Error fetching transactions for history page:', e);
  dbConnected = false;
}

// Cálculo de Métricas Mensuales
const currentYear = now.getFullYear();
const currentMonth = now.getMonth();
const currentDay = now.getDate();

const thisMonthTransactions = allTransactions.filter((t) => {
  return t.date.getFullYear() === currentYear && t.date.getMonth() === currentMonth;
});

const totalMonthSpent = thisMonthTransactions.reduce((acc, t) => acc + t.amount, 0);
const dailyAverage = currentDay > 0 ? (totalMonthSpent / currentDay) : 0;

// Presupuesto mensual total referencial (Gastos variables + intocables = L. 9,000 + L. 8,750 = L. 17,750)
const MONTHLY_BUDGET_TARGET = 17750.0;
const percentUsed = Math.min(100, Math.round((totalMonthSpent / MONTHLY_BUDGET_TARGET) * 100));

// Distribución Semanal (Sem 1: 1-7, Sem 2: 8-14, Sem 3: 15-21, Sem 4: 22+)
let week1Spent = 0;
let week2Spent = 0;
let week3Spent = 0;
let week4Spent = 0;

thisMonthTransactions.forEach((t) => {
  const day = t.date.getDate();
  if (day <= 7) week1Spent += t.amount;
  else if (day <= 14) week2Spent += t.amount;
  else if (day <= 21) week3Spent += t.amount;
  else week4Spent += t.amount;
});

const maxWeekVal = Math.max(week1Spent, week2Spent, week3Spent, week4Spent, 100);
const weekHeights = {
  w1: Math.max(14, Math.round((week1Spent / maxWeekVal) * 100)),
  w2: Math.max(14, Math.round((week2Spent / maxWeekVal) * 100)),
  w3: Math.max(14, Math.round((week3Spent / maxWeekVal) * 100)),
  w4: Math.max(14, Math.round((week4Spent / maxWeekVal) * 100)),
};

// Agrupación Cronológica por Día
const dayGroupsMap = new Map<string, DayGroup>();

const todayKey = now.toISOString().slice(0, 10);
const yesterday = new Date(now);
yesterday.setDate(yesterday.getDate() - 1);
const yesterdayKey = yesterday.toISOString().slice(0, 10);

allTransactions.forEach((t) => {
  if (!dayGroupsMap.has(t.dateKey)) {
    let displayDate = t.date.toLocaleDateString('es-HN', { day: 'numeric', month: 'long' });
    if (t.dateKey === todayKey) {
      displayDate = `Hoy, ${displayDate}`;
    } else if (t.dateKey === yesterdayKey) {
      displayDate = `Ayer, ${displayDate}`;
    }

    dayGroupsMap.set(t.dateKey, {
      dateKey: t.dateKey,
      displayDate,
      totalDay: 0,
      items: [],
    });
  }

  const group = dayGroupsMap.get(t.dateKey)!;
  group.items.push(t);
  group.totalDay += t.amount;
});

const groupedTransactions = Array.from(dayGroupsMap.values());
const creditCount = allTransactions.filter((t) => t.paymentMethod === 'TARJETA_CREDITO').length;
---

<Layout title="Gastos e Historial" activeTab="gastos">
  <div class="flex flex-col gap-4">

    <!-- 1. Month Selector & Spend Overview Card (Canopy Nocturne Design System) -->
    <section class="bg-surface-container-low rounded-2xl p-4 shadow-md relative overflow-hidden border border-outline-variant/20">
      <!-- Glow botánico sutil -->
      <div class="absolute -top-12 -right-12 w-32 h-32 bg-primary/10 rounded-full blur-2xl pointer-events-none"></div>
      
      <div class="flex items-center justify-between relative z-10 mb-3">
        <div class="flex items-center gap-1.5">
          <span class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[18px]">calendar_today</span>
          </span>
          <span class="font-bold text-sm text-on-surface font-headline">{capitalizedMonth}</span>
        </div>
        <div class="flex items-center gap-1 bg-surface-container px-2.5 py-1 rounded-full text-primary border border-outline-variant/20">
          <span class="material-symbols-outlined text-[15px]">shield</span>
          <span class="text-[11px] font-semibold">Supervivencia</span>
        </div>
      </div>

      <!-- Números Principales de Métricas -->
      <div class="space-y-1 relative z-10">
        <p class="text-[11px] text-on-surface-variant font-medium">Total gastado en el mes</p>
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-black text-primary tracking-tight font-headline tabular-nums">
            L. {totalMonthSpent.toLocaleString('es-HN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
          </h2>
          <div class="text-right">
            <span class="text-[10px] text-on-surface-variant block">Promedio ritmo</span>
            <span class="text-xs text-on-surface font-bold tabular-nums">
              L. {dailyAverage.toFixed(2)}<span class="text-on-surface-variant text-[10px] font-normal">/día</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Barra de Progreso del Presupuesto Mensual -->
      <div class="mt-3 pt-1">
        <div class="flex justify-between items-center mb-1 text-[11px] text-on-surface-variant">
          <span>Presupuesto límite (L. {MONTHLY_BUDGET_TARGET.toLocaleString('es-HN')})</span>
          <span class={percentUsed > 85 ? 'text-error font-bold' : 'text-primary font-bold'}>
            {percentUsed}% utilizado
          </span>
        </div>
        <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
          <div
            class={`h-full rounded-full transition-all duration-500 ${percentUsed > 85 ? 'bg-error' : percentUsed > 60 ? 'bg-secondary' : 'bg-primary'}`}
            style={`width: ${percentUsed}%;`}
          ></div>
        </div>
      </div>
    </section>

    <!-- 2. Weekly Breakdown Spark Bar Chart (Distribución Semanal) -->
    <section class="bg-surface-container rounded-2xl p-4 shadow-sm border border-outline-variant/20">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-primary text-[20px]">bar_chart</span>
          <h3 class="font-bold text-xs text-on-surface font-headline">Distribución semanal</h3>
        </div>
        <span class="text-[10px] text-secondary bg-surface-container-high px-2 py-0.5 rounded-full font-semibold">
          4 semanas
        </span>
      </div>

      <!-- Visualización de Barras de Distribución Semanal -->
      <div class="grid grid-cols-4 gap-2 pt-2 items-end h-32 border-b border-outline-variant/15 pb-2">
        <!-- Sem 1 -->
        <div class="flex flex-col items-center gap-1 h-full justify-end group">
          <span class="text-[10px] text-on-surface-variant group-hover:text-primary transition-colors tabular-nums">
            L. {week1Spent.toFixed(0)}
          </span>
          <div class="w-full max-w-[36px] bg-surface-container-highest rounded-t-lg relative overflow-hidden flex flex-col justify-end" style={`height: ${weekHeights.w1}%;`}>
            <div class="w-full bg-primary/80 group-hover:bg-primary transition-all duration-300 rounded-t-lg h-full"></div>
          </div>
          <span class="text-[10px] text-on-surface-variant mt-0.5">Sem 1</span>
        </div>

        <!-- Sem 2 -->
        <div class="flex flex-col items-center gap-1 h-full justify-end group">
          <span class="text-[10px] text-on-surface-variant group-hover:text-primary transition-colors tabular-nums">
            L. {week2Spent.toFixed(0)}
          </span>
          <div class="w-full max-w-[36px] bg-surface-container-highest rounded-t-lg relative overflow-hidden flex flex-col justify-end" style={`height: ${weekHeights.w2}%;`}>
            <div class="w-full bg-primary group-hover:brightness-110 transition-all duration-300 rounded-t-lg h-full"></div>
          </div>
          <span class="text-[10px] text-on-surface-variant mt-0.5">Sem 2</span>
        </div>

        <!-- Sem 3 -->
        <div class="flex flex-col items-center gap-1 h-full justify-end group">
          <span class="text-[10px] text-on-surface-variant group-hover:text-primary transition-colors tabular-nums">
            L. {week3Spent.toFixed(0)}
          </span>
          <div class="w-full max-w-[36px] bg-surface-container-highest rounded-t-lg relative overflow-hidden flex flex-col justify-end" style={`height: ${weekHeights.w3}%;`}>
            <div class="w-full bg-primary/80 group-hover:bg-primary transition-all duration-300 rounded-t-lg h-full"></div>
          </div>
          <span class="text-[10px] text-on-surface-variant mt-0.5">Sem 3</span>
        </div>

        <!-- Sem 4 -->
        <div class="flex flex-col items-center gap-1 h-full justify-end group">
          <span class="text-[10px] text-secondary font-semibold tabular-nums">
            L. {week4Spent.toFixed(0)}
          </span>
          <div class="w-full max-w-[36px] bg-surface-container-highest rounded-t-lg relative overflow-hidden flex flex-col justify-end" style={`height: ${weekHeights.w4}%;`}>
            <div class="w-full bg-secondary transition-all duration-300 rounded-t-lg h-full"></div>
          </div>
          <span class="text-[10px] text-secondary font-semibold mt-0.5">Sem 4</span>
        </div>
      </div>
    </section>

    <!-- 3. Buscador y Filtros Interactivos (Chips Deslizables) -->
    <section class="space-y-2.5">
      <!-- Barra de Búsqueda -->
      <div class="relative w-full">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
        <input
          id="expense-search"
          type="text"
          placeholder="Buscar comercio, concepto o monto..."
          class="w-full h-11 pl-10 pr-9 bg-surface-container-low text-on-surface rounded-full text-xs placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/20 transition-all"
        />
        <button
          id="btn-clear-search"
          type="button"
          class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface"
        >
          <span class="material-symbols-outlined text-[16px]">close</span>
        </button>
      </div>

      <!-- Filtros en Pastillas Deslizables Horizontalmente -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar" id="filter-container">
        <button
          type="button"
          class="filter-chip px-3.5 py-1.5 rounded-full bg-primary text-on-primary text-xs whitespace-nowrap shadow-sm font-bold transition-all shrink-0"
          data-filter="all"
        >
          Todos ({allTransactions.length})
        </button>

        <!-- Filtros por Método de Pago (Vital para Modo Supervivencia) -->
        <button
          type="button"
          class="filter-chip px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface text-xs whitespace-nowrap transition-all border border-outline-variant/20 shrink-0"
          data-payment="DEBITO_EFECTIVO"
        >
          💳 Débito/Efectivo
        </button>
        <button
          type="button"
          class="filter-chip px-3 py-1.5 rounded-full bg-surface-container text-error hover:bg-error/10 text-xs whitespace-nowrap transition-all border border-outline-variant/20 shrink-0 flex items-center gap-1"
          data-payment="TARJETA_CREDITO"
        >
          <span class="material-symbols-outlined text-[13px]">warning</span>
          Crédito ({creditCount})
        </button>

        <!-- Filtros por Categorías del Presupuesto -->
        <button
          type="button"
          class="filter-chip px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface text-xs whitespace-nowrap transition-all border border-outline-variant/20 shrink-0"
          data-filter="supermercado"
        >
          🛒 Supermercado
        </button>
        <button
          type="button"
          class="filter-chip px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface text-xs whitespace-nowrap transition-all border border-outline-variant/20 shrink-0"
          data-filter="gasolina"
        >
          ⛽ Gasolina
        </button>
        <button
          type="button"
          class="filter-chip px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface text-xs whitespace-nowrap transition-all border border-outline-variant/20 shrink-0"
          data-filter="ocio"
        >
          🎮 Ocio y Hormiga
        </button>
        <button
          type="button"
          class="filter-chip px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface text-xs whitespace-nowrap transition-all border border-outline-variant/20 shrink-0"
          data-filter="software"
        >
          💻 Software
        </button>
        <button
          type="button"
          class="filter-chip px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface text-xs whitespace-nowrap transition-all border border-outline-variant/20 shrink-0"
          data-filter="maestria"
        >
          🎓 Maestría
        </button>
        <button
          type="button"
          class="filter-chip px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface text-xs whitespace-nowrap transition-all border border-outline-variant/20 shrink-0"
          data-filter="deudas"
        >
          🏦 Deudas Fijas
        </button>
      </div>
    </section>

    <!-- 4. Histórico Cronológico Agrupado por Fecha -->
    <section class="space-y-3 pt-1" id="expense-timeline">
      {groupedTransactions.length === 0 ? (
        <div class="bg-surface-container rounded-2xl p-8 text-center border border-outline-variant/20 flex flex-col items-center justify-center gap-2">
          <span class="material-symbols-outlined text-4xl text-on-surface-variant">receipt_long</span>
          <p class="text-xs font-bold text-on-surface">Aún no hay movimientos registrados</p>
          <p class="text-[11px] text-on-surface-variant max-w-xs">
            Registra tu primer gasto desde el botón (+) en el Dashboard.
          </p>
          <a href="/" class="mt-2 text-xs font-semibold text-primary hover:underline flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            Volver al Dashboard
          </a>
        </div>
      ) : (
        groupedTransactions.map((group) => (
          <div class="space-y-1.5 expense-day-group" data-date={group.dateKey}>
            <div class="flex items-center justify-between px-1">
              <h4 class="text-[11px] font-bold text-on-surface-variant uppercase tracking-wider">
                {group.displayDate}
              </h4>
              <span class="text-[11px] font-semibold text-on-surface-variant tabular-nums">
                -L. {group.totalDay.toLocaleString('es-HN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
              </span>
            </div>

            <div class="space-y-2">
              {group.items.map((item) => (
                <div
                  class="expense-item flex items-center justify-between p-3.5 bg-surface-container rounded-xl hover:bg-surface-container-high transition-colors cursor-pointer border border-outline-variant/10 shadow-sm"
                  data-category={item.categoryFilterKey}
                  data-payment={item.paymentMethod}
                  data-search={`${item.description} ${item.categoryName} ${item.amountFormatted}`.toLowerCase()}
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div class={`w-10 h-10 rounded-full flex items-center justify-center shrink-0 ${
                      item.paymentMethod === 'TARJETA_CREDITO'
                        ? 'bg-error/15 text-error'
                        : 'bg-primary/10 text-primary'
                    }`}>
                      <span class="material-symbols-outlined text-[20px]">{item.materialIcon}</span>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs font-bold text-on-surface truncate leading-tight">
                        {item.description}
                      </p>
                      <div class="flex items-center gap-1.5 text-on-surface-variant text-[10px] mt-0.5">
                        <span>{item.categoryName}</span>
                        <span class="opacity-60">•</span>
                        <span>{item.timeFormatted}</span>
                      </div>
                    </div>
                  </div>

                  <div class="text-right shrink-0 pl-2">
                    <span class="text-xs font-bold text-on-surface block tabular-nums">
                      -L. {item.amountFormatted}
                    </span>
                    {item.paymentMethod === 'TARJETA_CREDITO' ? (
                      <span class="text-[10px] text-error font-bold flex items-center justify-end gap-0.5">
                        <span class="material-symbols-outlined text-[11px]">warning</span>
                        Crédito
                      </span>
                    ) : (
                      <span class="text-[10px] text-secondary font-medium">
                        Débito
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      )}

      <!-- Mensaje cuando la búsqueda o filtro no tiene coincidencias -->
      <div id="no-filter-results" class="hidden bg-surface-container rounded-2xl p-6 text-center border border-outline-variant/20 space-y-1">
        <span class="material-symbols-outlined text-3xl text-on-surface-variant">search_off</span>
        <p class="text-xs font-bold text-on-surface">No se encontraron movimientos</p>
        <p class="text-[10px] text-on-surface-variant">Intenta ajustar los filtros o el texto de búsqueda.</p>
      </div>
    </section>

    <!-- 5. Card Informativo de Modo Rescate -->
    <div class="p-3.5 rounded-2xl bg-surface-container-high border border-outline-variant/20 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0">
          <span class="material-symbols-outlined text-[20px]">verified_user</span>
        </div>
        <div>
          <h5 class="font-bold text-xs text-on-surface font-headline leading-tight">Regla de Supervivencia Activa</h5>
          <p class="text-[10px] text-on-surface-variant">
            {creditCount > 0
              ? `Has registrado ${creditCount} gasto(s) con Crédito. ¡Prioriza Débito para no generar intereses!`
              : 'Excelente: 100% de gastos registrados con Débito/Efectivo.'}
          </p>
        </div>
      </div>
      <span class="material-symbols-outlined text-primary text-[18px]">lock</span>
    </div>

    <!-- 6. Acciones de Exportación (PDF y CSV) -->
    <section class="pt-1 pb-4">
      <div class="grid grid-cols-2 gap-2">
        <button
          type="button"
          id="export-pdf-btn"
          class="flex items-center justify-center gap-1.5 h-11 px-3 rounded-full bg-surface-container hover:bg-surface-container-highest text-on-surface text-xs font-semibold transition-all active:scale-[0.98] border border-outline-variant/20 shadow-sm"
        >
          <span class="material-symbols-outlined text-[18px] text-secondary">picture_as_pdf</span>
          <span>Imprimir / PDF</span>
        </button>

        <button
          type="button"
          id="export-csv-btn"
          class="flex items-center justify-center gap-1.5 h-11 px-3 rounded-full bg-surface-container hover:bg-surface-container-highest text-on-surface text-xs font-semibold transition-all active:scale-[0.98] border border-outline-variant/20 shadow-sm"
        >
          <span class="material-symbols-outlined text-[18px] text-primary">table_chart</span>
          <span>Descargar CSV</span>
        </button>
      </div>
    </section>

  </div>

  <!-- SCRIPT CLIENTE PARA FILTROS, BÚSQUEDA Y EXPORTACIONES -->
  <script is:inline define:vars={{ allTxData: allTransactions }}>
    document.addEventListener('DOMContentLoaded', () => {
      const filterButtons = document.querySelectorAll('.filter-chip');
      const expenseItems = document.querySelectorAll('.expense-item');
      const dayGroups = document.querySelectorAll('.expense-day-group');
      const searchInput = document.getElementById('expense-search');
      const btnClearSearch = document.getElementById('btn-clear-search');
      const noResultsMsg = document.getElementById('no-filter-results');

      let currentCategoryFilter = 'all';
      let currentPaymentFilter = null;
      let currentSearchTerm = '';

      function applyFilters() {
        let totalVisible = 0;

        expenseItems.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          const itemPay = item.getAttribute('data-payment');
          const itemSearch = item.getAttribute('data-search') || '';

          const matchCategory = currentCategoryFilter === 'all' || itemCat === currentCategoryFilter;
          const matchPayment = !currentPaymentFilter || itemPay === currentPaymentFilter;
          const matchSearch = !currentSearchTerm || itemSearch.includes(currentSearchTerm);

          if (matchCategory && matchPayment && matchSearch) {
            item.style.display = 'flex';
            totalVisible++;
          } else {
            item.style.display = 'none';
          }
        });

        // Ocultar cabeceras de días vacíos
        dayGroups.forEach((group) => {
          let hasVisible = false;
          group.querySelectorAll('.expense-item').forEach((i) => {
            if (i.style.display !== 'none') hasVisible = true;
          });
          group.style.display = hasVisible ? 'block' : 'none';
        });

        // Mostrar / ocultar mensaje de "No se encontraron movimientos"
        if (noResultsMsg) {
          noResultsMsg.classList.toggle('hidden', totalVisible > 0 || expenseItems.length === 0);
        }
      }

      // Manejador de clic en chips de filtro
      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          // Desactivar todos los estilos activos
          filterButtons.forEach((b) => {
            b.classList.remove('bg-primary', 'text-on-primary', 'font-bold');
            b.classList.add('bg-surface-container', 'text-on-surface-variant');
          });

          // Activar el seleccionado
          btn.classList.add('bg-primary', 'text-on-primary', 'font-bold');
          btn.classList.remove('bg-surface-container', 'text-on-surface-variant');

          const filterCat = btn.getAttribute('data-filter');
          const filterPay = btn.getAttribute('data-payment');

          if (filterCat) {
            currentCategoryFilter = filterCat;
            currentPaymentFilter = null;
          } else if (filterPay) {
            currentPaymentFilter = filterPay;
            currentCategoryFilter = 'all';
          }

          applyFilters();
        });
      });

      // Búsqueda en vivo
      searchInput?.addEventListener('input', (e) => {
        currentSearchTerm = e.target.value.trim().toLowerCase();
        if (btnClearSearch) {
          btnClearSearch.classList.toggle('hidden', currentSearchTerm.length === 0);
        }
        applyFilters();
      });

      btnClearSearch?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentSearchTerm = '';
        btnClearSearch.classList.add('hidden');
        applyFilters();
      });

      // Exportar PDF / Imprimir
      document.getElementById('export-pdf-btn')?.addEventListener('click', () => {
        window.print();
      });

      // Exportar CSV
      document.getElementById('export-csv-btn')?.addEventListener('click', () => {
        if (!allTxData || allTxData.length === 0) {
          alert('No hay transacciones registradas para exportar.');
          return;
        }

        const headers = ['ID', 'Fecha', 'Hora', 'Descripción', 'Categoría', 'Método de Pago', 'Monto (L.)'];
        const csvRows = [headers.join(',')];

        allTxData.forEach((t) => {
          const row = [
            t.id,
            `"${t.dateKey}"`,
            `"${t.timeFormatted}"`,
            `"${(t.description || '').replace(/"/g, '""')}"`,
            `"${(t.categoryName || '').replace(/"/g, '""')}"`,
            `"${t.paymentMethod}"`,
            t.amount.toFixed(2),
          ];
          csvRows.push(row.join(','));
        });

        const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(csvRows.join('\n'));
        const link = document.createElement('a');
        link.setAttribute('href', csvContent);
        link.setAttribute('download', `cronos_gastos_${new Date().toISOString().slice(0, 10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    });
  </script>
</Layout>
