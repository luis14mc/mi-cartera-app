              type="checkbox"
              data-leak-id="amazonprime"
              class="checkbox checkbox-error checkbox-sm rounded-md"
            />
            <div class="flex-1 flex justify-between items-center text-xs">
              <span class="font-medium text-on-surface leak-title">Cancelar Amazon Prime</span>
              <span class="bg-surface-container px-2 py-0.5 rounded-full text-[10px] font-bold text-error">$16.04</span>
            </div>
