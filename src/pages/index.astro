    </div>

  </div>

  <!-- FLOATING ACTION BUTTON (FAB) ESTILO CANOPY EMERALD -->
  <button
    id="btn-open-fab"
    type="button"
    class="w-14 h-14 rounded-full bg-primary text-on-primary shadow-[0_4px_20px_rgba(30,184,84,0.35)] fixed bottom-20 right-6 z-40 flex items-center justify-center hover:scale-105 active:scale-95 transition-all focus-visible:ring-2 focus-visible:ring-primary"
    title="Añadir transacción"
    aria-label="Registrar nueva transacción"
  >
    <span class="material-symbols-outlined text-[28px]">add</span>
  </button>

  <!-- MODAL / BOTTOM SHEET: NUEVO GASTO (CANOPY NOCTURNE DESIGN SYSTEM) -->
  <dialog id="modal_quick_expense" class="modal modal-bottom sm:modal-middle" aria-labelledby="modal_quick_title" aria-modal="true">
    <div class="modal-box p-5 bg-surface-container border border-outline-variant/30 text-on-surface max-w-md mx-auto shadow-2xl rounded-t-3xl sm:rounded-3xl">
      <div class="flex justify-between items-center mb-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-primary/20 text-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-[19px]">add_circle</span>
          </div>
          <h3 id="modal_quick_title" class="font-bold text-base text-on-surface font-headline">
            Nueva Transacción
          </h3>
        </div>
        <form method="dialog">
          <button class="w-8 h-8 rounded-full bg-surface-container-high text-on-surface-variant flex items-center justify-center hover:text-on-surface transition-colors" aria-label="Cerrar modal de nueva transacción">
            <span class="material-symbols-outlined text-[18px]">close</span>
          </button>
        </form>
      </div>

      <form id="cronos-transaction-form" class="space-y-4">
        <!-- Display de Monto Gigante (como en nuevo_gasto_daisyui_forest) -->
        <div class="relative overflow-hidden rounded-2xl bg-surface-container-lowest p-4 text-center border border-outline-variant/15 shadow-inner">
          <label class="block text-[10px] text-tertiary uppercase tracking-wider font-semibold mb-1" for="quick_amount">
            Monto a debitar
          </label>
          <div class="inline-flex items-center justify-center text-3xl font-extrabold text-on-surface tracking-tight font-headline">
            <span class="text-primary mr-1 font-bold">L.</span>
            <input
              type="number"
              id="quick_amount"
              name="amount"
              step="0.01"
              min="0.01"
              placeholder="0.00"
              required
              class="w-44 text-center bg-transparent border-b-2 border-primary focus:outline-none text-on-surface font-extrabold text-3xl placeholder:text-on-surface-variant/40"
            />
          </div>
          <p class="text-[10px] text-outline mt-1 font-medium">Validado contra Neon PostgreSQL</p>
        </div>

        <!-- Método de Pago Pill Toggle (como en mockups) -->
        <div class="space-y-1">
          <span class="block text-xs font-semibold text-on-surface-variant ml-1">
            Método de Pago (Bloqueo de Plástico)
          </span>
          <div class="grid grid-cols-2 gap-2 bg-surface-container-lowest p-1.5 rounded-full border border-outline-variant/15" id="payment-methods-pills">
            <label class="cursor-pointer py-2 px-3 rounded-full text-center transition-all flex items-center justify-center gap-1.5 has-[:checked]:bg-surface-container-high has-[:checked]:text-primary text-on-surface-variant font-semibold text-xs">
              <input
                type="radio"
                name="payment_method"
                id="pm_debito"
                value="DEBITO_EFECTIVO"
                checked
                class="hidden"
              />
              <span class="material-symbols-outlined text-[16px]">payments</span>
              <span>Débito / Efec.</span>
            </label>

            <label class="cursor-pointer py-2 px-3 rounded-full text-center transition-all flex items-center justify-center gap-1.5 has-[:checked]:bg-error/20 has-[:checked]:text-error text-on-surface-variant font-semibold text-xs">
              <input
                type="radio"
                name="payment_method"
                id="pm_credito"
                value="TARJETA_CREDITO"
                class="hidden"
