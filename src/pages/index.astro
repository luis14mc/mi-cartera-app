---
import Layout from '../layouts/Layout.astro';
import { db, schema } from '../db';
import { eq, and, gte, lte, desc } from 'drizzle-orm';

export const prerender = false;

// Parámetros financieros del MODO SUPERVIVENCIA (Octubre)
const MONTHLY_SALARY = 26518.0;
const UNTOUCHABLE_COMMITMENTS_TOTAL = 8750.0; // Maestría (4,350) + Deudas Fijas (4,400)
const DEBT_DUE_DAY = 20;

// Lógica de detección de fecha para Alerta Proactiva (Días 17 al 20)
const now = new Date();
const currentDay = now.getDate();
const isDebtAlertActive = currentDay >= 17 && currentDay <= DEBT_DUE_DAY;

interface CategoryItem {
  id: number;
  name: string;
  monthlyLimit: number;
  currentSpent: number;
  remaining: number;
  percentage: number;
  barColorClass: string;
  badgeClass: string;
  icon: string;
  materialIcon: string;
  isOcioDanger: boolean;
  isHardStopTriggered: boolean;
  isUntouchable: boolean;
  isPaid: boolean;
}

let dbConfigured = true;
let untouchableCommitments: CategoryItem[] = [];
let variableCategories: CategoryItem[] = [];
let totalVariableSpent = 0;
let totalUntouchableSpent = 0;
let allCategories: CategoryItem[] = [];
let recentTransactions: Array<{
  id: number;
  amount: string;
  description: string;
  paymentMethod: string;
  categoryName: string;
  icon: string;
  materialIcon: string;
  formattedDate: string;
}> = [];

// Helper para mapear iconos a Material Symbols Outlined
function getMaterialIcon(name: string, defaultIcon: string = 'label'): string {
  const n = name.toLowerCase();
  if (n.includes('maestr')) return 'school';
  if (n.includes('deuda') || n.includes('préstamo')) return 'account_balance';
  if (n.includes('supermercado') || n.includes('alimento')) return 'restaurant';
  if (n.includes('gasolina') || n.includes('transporte')) return 'local_gas_station';
  if (n.includes('ocio') || n.includes('hormiga')) return 'sports_esports';
  if (n.includes('software') || n.includes('tecnología')) return 'laptop';
  return defaultIcon;
}

try {
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0, 0);
  const endOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59, 999);

  // 1. Consultar categorías desde Neon
  const rawCategories = await db.select().from(schema.categories);

  for (const cat of rawCategories) {
    const catTransactions = await db
      .select({ amount: schema.transactions.amount })
      .from(schema.transactions)
      .where(
        and(
          eq(schema.transactions.category_id, cat.id),
          gte(schema.transactions.date, startOfMonth),
          lte(schema.transactions.date, endOfMonth)
        )
      );

    const spent = catTransactions.reduce((acc, t) => acc + parseFloat(t.amount || '0'), 0);
    const limit = parseFloat(cat.monthly_limit);
    const remaining = Math.max(0, limit - spent);
    const percentage = limit > 0 ? Math.min(Math.round((spent / limit) * 100), 100) : 0;

    const lowerName = cat.name.toLowerCase();
    const isUntouchable =
      lowerName.includes('maestr') || lowerName.includes('deuda') || lowerName.includes('préstamo');
    const isOcio = lowerName.includes('ocio') || lowerName.includes('hormiga');

    // Regla de Negocio: En "Ocio y Hormiga", si supera L. 1,000 se vuelve ROJO inmediatamente
    let barColorClass = 'bg-primary';
    let badgeClass = 'text-primary bg-primary/10';
    const isOcioDanger = isOcio && spent > 1000;

    if (isOcioDanger || percentage > 85) {
      barColorClass = 'bg-error';
      badgeClass = 'text-error bg-error/15';
    } else if (percentage > 60) {
      barColorClass = 'bg-secondary';
      badgeClass = 'text-secondary bg-secondary/10';
    }

    const item: CategoryItem = {
      id: cat.id,
      name: cat.name,
      monthlyLimit: limit,
      currentSpent: spent,
      remaining,
      percentage,
      barColorClass,
      badgeClass,
      icon: cat.icon || '📌',
      materialIcon: getMaterialIcon(cat.name),
      isOcioDanger,
      isHardStopTriggered: !isUntouchable && spent >= limit,
      isUntouchable,
      isPaid: isUntouchable && spent >= limit,
    };

    allCategories.push(item);

    if (isUntouchable) {
      untouchableCommitments.push(item);
      totalUntouchableSpent += spent;
    } else {
      variableCategories.push(item);
      totalVariableSpent += spent;
    }
  }

  // Ordenar compromisos intocables: Maestría primero, luego Deudas
  untouchableCommitments.sort((a, b) => (a.name.toLowerCase().includes('maestr') ? -1 : 1));

  // 2. Transacciones recientes
  const rawTransactions = await db
    .select({
      id: schema.transactions.id,
      amount: schema.transactions.amount,
      description: schema.transactions.description,
      paymentMethod: schema.transactions.payment_method,
      date: schema.transactions.date,
      categoryName: schema.categories.name,
      icon: schema.categories.icon,
    })
    .from(schema.transactions)
    .leftJoin(schema.categories, eq(schema.transactions.category_id, schema.categories.id))
    .orderBy(desc(schema.transactions.date))
    .limit(6);

  recentTransactions = rawTransactions.map((t) => ({
    id: t.id,
    amount: parseFloat(t.amount).toFixed(2),
    description: t.description || 'Gasto registrado',
    paymentMethod: t.paymentMethod || 'DEBITO_EFECTIVO',
    categoryName: t.categoryName || 'General',
    icon: t.icon || '🏷️',
    materialIcon: getMaterialIcon(t.categoryName || ''),
    formattedDate: new Date(t.date).toLocaleDateString('es-HN', {
      day: 'numeric',
      month: 'short',
    }),
  }));
} catch (error) {
  dbConfigured = false;
  // Fallback con datos locales si la BD no responde
  untouchableCommitments = [
    {
      id: 5,
      name: 'Maestría',
      monthlyLimit: 4350.0,
      currentSpent: 0.0,
      remaining: 4350.0,
      percentage: 0,
      barColorClass: 'bg-primary',
      badgeClass: 'text-primary bg-primary/10',
      icon: '🎓',
      materialIcon: 'school',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: true,
      isPaid: false,
    },
    {
      id: 6,
      name: 'Deudas/Préstamos Fijos',
      monthlyLimit: 4400.0,
      currentSpent: 0.0,
      remaining: 4400.0,
      percentage: 0,
      barColorClass: 'bg-primary',
      badgeClass: 'text-primary bg-primary/10',
      icon: '🏦',
      materialIcon: 'account_balance',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: true,
      isPaid: false,
    },
  ];

  variableCategories = [
    {
      id: 1,
      name: 'Supermercado',
      monthlyLimit: 4000.0,
      currentSpent: 0.0,
      remaining: 4000.0,
      percentage: 0,
      barColorClass: 'bg-primary',
      badgeClass: 'text-primary bg-primary/10',
      icon: '🛒',
      materialIcon: 'restaurant',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: false,
      isPaid: false,
    },
    {
      id: 2,
      name: 'Gasolina',
      monthlyLimit: 2000.0,
      currentSpent: 0.0,
      remaining: 2000.0,
      percentage: 0,
      barColorClass: 'bg-primary',
      badgeClass: 'text-primary bg-primary/10',
      icon: '⛽',
      materialIcon: 'local_gas_station',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: false,
      isPaid: false,
    },
    {
      id: 3,
      name: 'Ocio y Hormiga',
      monthlyLimit: 1500.0,
      currentSpent: 0.0,
      remaining: 1500.0,
      percentage: 0,
      barColorClass: 'bg-primary',
      badgeClass: 'text-primary bg-primary/10',
      icon: '🐜',
      materialIcon: 'sports_esports',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: false,
      isPaid: false,
    },
    {
      id: 4,
      name: 'Software (Vital)',
      monthlyLimit: 1500.0,
      currentSpent: 0.0,
      remaining: 1500.0,
      percentage: 0,
      barColorClass: 'bg-primary',
      badgeClass: 'text-primary bg-primary/10',
      icon: '💻',
      materialIcon: 'laptop',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: false,
      isPaid: false,
    },
  ];

  allCategories = [...untouchableCommitments, ...variableCategories];
  totalVariableSpent = 0.0;
  totalUntouchableSpent = 0.0;
}

// 🛑 MATEMÁTICA ESTRICTA DE LIQUIDEZ REAL:
// Los L. 8,750 (Maestría 4,350 + Deuda 4,400) se restan automáticamente desde el día 1.
const initialRealLiquidity = MONTHLY_SALARY - UNTOUCHABLE_COMMITMENTS_TOTAL; // L. 17,768.00
const disposableSalary = initialRealLiquidity - totalVariableSpent;
const variableBudgetTotal = variableCategories.reduce((acc, c) => acc + c.monthlyLimit, 0);
const overallSpentPct = variableBudgetTotal > 0
  ? Math.min(100, Math.round((totalVariableSpent / variableBudgetTotal) * 100))
  : 0;
---

<Layout title="CRONOS - MODO RESCATE (OCTUBRE)">
  <div class="flex flex-col gap-4 text-on-surface">

    <!-- TAG DE ESTADO Y CONTEXTO SERVERLESS -->
    <div class="flex items-center justify-between pt-1">
      <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-low text-on-surface-variant text-[11px] border border-outline-variant/15">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="font-semibold uppercase tracking-wider">Validación SSR Activa</span>
      </div>
      <span class="text-[11px] text-tertiary font-medium">Neon DB Synced</span>
    </div>

    <!-- BANNER DE INSTALACIÓN PWA EN CELULAR -->
    <div id="pwa-install-banner" class="rounded-2xl bg-surface-container-high border border-primary/30 p-3 flex items-center justify-between shadow-md transition-all">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-9 h-9 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[20px]">install_mobile</span>
        </div>
        <div class="min-w-0">
          <h4 class="font-bold text-xs text-on-surface font-headline leading-tight">
            Instalar CRONOS en tu Celular
          </h4>
          <p class="text-[10px] text-on-surface-variant truncate">
            Pantalla completa, rápido y sin navegador
          </p>
        </div>
      </div>
      <button
        type="button"
        class="btn-trigger-pwa-install text-xs font-bold text-on-primary bg-primary px-3.5 py-1.5 rounded-full hover:brightness-110 active:scale-95 transition-all shadow-sm shrink-0"
      >
        Instalar
      </button>
    </div>

    <!-- ALERTA DE RESCATE: PÉRDIDA DE PERIODO DE GRACIA -->
    <div class="rounded-2xl bg-surface-container-low p-3.5 border border-error/30 shadow-md flex items-start gap-3">
      <div class="w-8 h-8 rounded-full bg-error-container/30 text-error flex items-center justify-center shrink-0 mt-0.5">
        <span class="material-symbols-outlined text-[19px]">warning</span>
      </div>
      <div class="min-w-0">
        <div class="flex items-center gap-1.5 flex-wrap">
          <h4 class="font-bold text-xs uppercase tracking-wide text-error">
            Modo Supervivencia Activo
          </h4>
          <span class="badge badge-error text-error-content badge-xs font-black">SIN GRACIA</span>
        </div>
        <p class="text-[11px] text-on-surface-variant font-medium leading-relaxed mt-0.5">
          Has perdido el periodo de gracia en tus tarjetas. Todo cobro a crédito generará intereses inmediatos. <strong>Usa Débito o cancela</strong>.
        </p>
      </div>
    </div>

    <!-- CONTROL SEGMENTADO DE VISTAS (LIQUID GLASS BAR) -->
    <!-- Elimina la vista en un solo chorizo y permite ver cada sección de forma activa y enfocada -->
    <div class="sticky top-[54px] z-30 py-1 -mx-1 px-1">
      <div class="liquid-glass rounded-2xl p-1 flex items-center gap-1 shadow-lg overflow-x-auto no-scrollbar" id="dashboard-view-tabs">
        <button
          type="button"
          data-view="resumen"
          class="view-tab-btn flex-1 min-w-[76px] py-1.5 px-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-1 transition-all active:scale-95 bg-primary text-on-primary shadow-[0_2px_10px_rgba(30,184,84,0.35),inset_0_1px_0_rgba(255,255,255,0.25)]"
        >
          <span class="material-symbols-outlined text-[16px]">grid_view</span>
          <span>Resumen</span>
        </button>
        <button
          type="button"
          data-view="compromisos"
          class="view-tab-btn flex-1 min-w-[92px] py-1.5 px-2.5 rounded-xl text-xs font-medium text-on-surface-variant hover:text-on-surface flex items-center justify-center gap-1 transition-all active:scale-95"
        >
          <span class="material-symbols-outlined text-[16px]">lock</span>
          <span>Intocables</span>
          <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
        </button>
        <button
          type="button"
          data-view="categorias"
          class="view-tab-btn flex-1 min-w-[84px] py-1.5 px-2.5 rounded-xl text-xs font-medium text-on-surface-variant hover:text-on-surface flex items-center justify-center gap-1 transition-all active:scale-95"
        >
          <span class="material-symbols-outlined text-[16px]">pie_chart</span>
          <span>Límites</span>
        </button>
        <button
          type="button"
          data-view="fugas"
          class="view-tab-btn flex-1 min-w-[74px] py-1.5 px-2.5 rounded-xl text-xs font-medium text-on-surface-variant hover:text-on-surface flex items-center justify-center gap-1 transition-all active:scale-95"
        >
          <span class="material-symbols-outlined text-[16px]">content_cut</span>
          <span>Fugas</span>
        </button>
        <button
          type="button"
          data-view="todo"
          class="view-tab-btn py-1.5 px-2 rounded-xl text-xs font-medium text-on-surface-variant hover:text-on-surface flex items-center justify-center gap-0.5 transition-all active:scale-95"
          title="Ver todo continuo"
        >
          <span class="material-symbols-outlined text-[16px]">unfold_more</span>
        </button>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 1. VISTA: RESUMEN GENERAL (HERO + RECIENTES) -->
    <!-- ========================================== -->
    <div id="panel-resumen" class="view-panel space-y-3.5 transition-opacity duration-300">
      <!-- RESUMEN DE BALANCE MENSUAL (HERO CARD LIQUID GLASS) -->
      <section class="liquid-glass-card rounded-2xl p-4.5 flex flex-col gap-3 relative overflow-hidden">
        <div class="flex items-center justify-between">
          <div class="flex flex-col">
            <span class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider">
              Control Mensual
            </span>
            <span class="font-bold text-base text-on-surface tracking-tight font-headline">
              Liquidez Real Disponible
            </span>
          </div>
          <div class="flex items-center gap-1 bg-surface-container-high/80 px-3 py-1 rounded-full text-secondary text-xs font-semibold border border-outline-variant/20">
            <span class="material-symbols-outlined text-[15px]">calendar_today</span>
            <span>Octubre</span>
          </div>
        </div>

        <!-- Cifra y Barra Minimalista Orgánica -->
        <div class="flex flex-col gap-1 my-0.5">
          <div class="flex items-baseline gap-2 flex-wrap">
            <span class="text-3xl sm:text-4xl font-extrabold tracking-tight text-on-surface font-headline">
              L. {disposableSalary.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
            </span>
            <span class="text-xs text-on-surface-variant font-medium">
              / L. {MONTHLY_SALARY.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
            </span>
          </div>

          <!-- Barra de progreso orgánica sutil -->
          <div class="w-full bg-surface-container-lowest h-2 rounded-full overflow-hidden mt-1.5">
            <div
              class="bg-primary h-full rounded-full transition-all duration-500 ease-out"
              style={`width: ${Math.max(5, 100 - overallSpentPct)}%`}
            ></div>
          </div>

          <div class="flex justify-between items-center text-[11px] text-on-surface-variant font-medium pt-0.5">
            <span>L. 8,750 Congelados al inicio</span>
            <span class="text-primary font-semibold">
              {disposableSalary > 0 ? 'Liquidez controlada' : 'Límite alcanzado'}
            </span>
          </div>
        </div>

        <!-- Indicadores Secundarios en Surface-Container-Low -->
        <div class="grid grid-cols-2 gap-2 pt-1">
          <div class="bg-surface-container-low/70 p-2.5 rounded-xl border border-outline-variant/15 flex flex-col gap-0.5">
            <span class="text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold">
              Compromisos Fijos
            </span>
            <span class="text-xs sm:text-sm font-bold text-secondary font-headline">
              -L. {UNTOUCHABLE_COMMITMENTS_TOTAL.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
            </span>
            <span class="text-[9px] text-on-surface-variant/70">Maestría + Préstamo</span>
          </div>
          <div class="bg-surface-container-low/70 p-2.5 rounded-xl border border-outline-variant/15 flex flex-col gap-0.5">
            <span class="text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold">
              Gastos Variables
            </span>
            <span class="text-xs sm:text-sm font-bold text-error font-headline">
              L. {totalVariableSpent.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
            </span>
            <span class="text-[9px] text-on-surface-variant/70">Super, Gas, Ocio, Soft</span>
          </div>
        </div>
      </section>

      <!-- Tarjeta de Acceso a Módulos con Liquid Glass -->
      <div class="grid grid-cols-2 gap-2">
        <button
          type="button"
          onclick="window.switchDashboardView('compromisos')"
          class="liquid-glass p-3 rounded-2xl flex flex-col items-start gap-1 hover:border-secondary/40 transition-all text-left group"
        >
          <div class="w-8 h-8 rounded-full bg-secondary/15 text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-[18px]">lock</span>
          </div>
          <span class="text-xs font-bold text-on-surface mt-1 group-hover:text-secondary transition-colors">Compromisos</span>
          <span class="text-[10px] text-on-surface-variant">L. 8,750 fijados</span>
        </button>

        <button
          type="button"
          onclick="window.switchDashboardView('categorias')"
          class="liquid-glass p-3 rounded-2xl flex flex-col items-start gap-1 hover:border-primary/40 transition-all text-left group"
        >
          <div class="w-8 h-8 rounded-full bg-primary/15 text-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-[18px]">pie_chart</span>
          </div>
          <span class="text-xs font-bold text-on-surface mt-1 group-hover:text-primary transition-colors">Gastos Variables</span>
          <span class="text-[10px] text-on-surface-variant">4 categorías</span>
        </button>
      </div>

      <!-- HISTORIAL RECIENTE DE GASTOS -->
      {recentTransactions.length > 0 && (
        <section class="flex flex-col gap-2.5">
          <div class="flex items-center justify-between px-1">
            <h2 class="font-bold text-sm text-on-surface tracking-tight font-headline">
              Últimos movimientos
            </h2>
            <a href="/gastos" class="text-[11px] text-primary hover:underline font-semibold flex items-center gap-0.5">
              Ver históricos
              <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
            </a>
          </div>

          <div class="liquid-glass-card rounded-2xl overflow-hidden divide-y divide-outline-variant/15 border border-outline-variant/20 shadow-md">
            {recentTransactions.map((item) => (
              <div class="p-3 flex items-center justify-between hover:bg-surface-container-high/30 transition-colors">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-tertiary shrink-0">
                    <span class="material-symbols-outlined text-[17px]">{item.materialIcon}</span>
                  </div>
                  <div>
                    <p class="font-bold text-xs text-on-surface leading-tight">{item.description}</p>
                    <div class="flex items-center gap-1.5 mt-0.5">
                      <span class="text-[10px] text-on-surface-variant">
                        {item.categoryName} • {item.formattedDate}
                      </span>
                      {item.paymentMethod === 'TARJETA_CREDITO' ? (
                        <span class="bg-error/15 text-error px-1.5 py-0.2 rounded-full text-[9px] font-bold">
                          Crédito
                        </span>
                      ) : (
                        <span class="bg-primary/15 text-primary px-1.5 py-0.2 rounded-full text-[9px] font-bold">
                          Débito
                        </span>
                      )}
                    </div>
                  </div>
                </div>
                <span class="font-bold text-xs text-on-surface tabular-nums">
                  L. {item.amount}
                </span>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- ========================================== -->
    <!-- 2. VISTA: COMPROMISOS INTOCABLES (PAGOS) -->
    <!-- ========================================== -->
    <div id="panel-compromisos" class="view-panel hidden space-y-3.5 transition-opacity duration-300">
      <!-- ALERTA PROACTIVA DE DEUDA FIJA (Días 17 al 20) -->
      {isDebtAlertActive && (
        <div class="rounded-2xl liquid-glass p-3.5 border border-warning/40 shadow-sm flex items-start gap-3 animate-pulse">
          <div class="w-8 h-8 rounded-full bg-warning/20 text-warning flex items-center justify-center shrink-0 mt-0.5">
            <span class="material-symbols-outlined text-[19px]">notifications_active</span>
          </div>
          <div>
            <h4 class="font-bold text-xs uppercase tracking-wider text-warning">
              ¡Compromiso Crítico Día 20!
            </h4>
            <p class="text-xs text-on-surface font-semibold leading-snug mt-0.5">
              Separa L. 4,400 para tarjetas/préstamo antes del día 20.
            </p>
          </div>
        </div>
      )}

      <!-- 🔒 SECCIÓN COMPROMISOS INTOCABLES (MAESTRÍA & DEUDAS FIJAS) -->
      <section id="section-commitments" class="liquid-glass-card rounded-2xl p-4 border border-primary/40 shadow-md flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-primary/20 text-primary flex items-center justify-center">
              <span class="material-symbols-outlined text-[18px]">lock</span>
            </div>
            <div>
              <h2 class="font-bold text-sm text-on-surface tracking-tight font-headline">
                Compromisos Intocables
              </h2>
              <p class="text-[10px] text-on-surface-variant">
                L. 8,750.00 congelados al inicio de cada mes
              </p>
            </div>
          </div>
          <span class="badge badge-primary text-on-primary text-[9px] font-bold px-2 py-0.5">
            PRIORIDAD MÁXIMA
          </span>
        </div>

        <!-- Tarjetas de Compromisos Intocables (Checklist Financiero) -->
        <div class="bg-surface-container-lowest/60 rounded-xl overflow-hidden divide-y divide-outline-variant/15 border border-outline-variant/20">
          {untouchableCommitments.map((cat) => (
            <div class="p-3.5 flex flex-col xs:flex-row xs:items-center justify-between gap-3 hover:bg-surface-container-high/30 transition-colors">
              <div class="flex items-center gap-3 min-w-0 flex-1">
                <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary shrink-0 shadow-sm">
                  <span class="material-symbols-outlined text-[20px]">{cat.materialIcon}</span>
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="font-bold text-xs sm:text-sm text-on-surface truncate font-headline">
                    {cat.name}
                  </h3>
                  <span class="text-[10px] text-on-surface-variant block">
                    {cat.name.toLowerCase().includes('maestr') ? 'Mensualidad Maestría' : 'Cuota Crédito Día 20'}
                  </span>
                </div>
              </div>

              <div class="flex items-center justify-between xs:justify-end gap-2.5 shrink-0 pl-13 xs:pl-0">
                <span class="font-bold text-xs sm:text-sm text-on-surface tabular-nums">
                  L. {cat.monthlyLimit.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
                </span>

                {cat.isPaid ? (
                  <span class="bg-primary/20 text-primary px-3 py-1 rounded-full text-[10px] font-bold flex items-center gap-1 shadow-sm shrink-0">
                    <span class="material-symbols-outlined text-[13px]">check_circle</span>
                    PAGADO
                  </span>
                ) : (
                  <button
                    type="button"
                    class="btn-pay-commitment text-[11px] font-semibold text-secondary bg-surface-container px-3.5 py-1.5 rounded-full hover:bg-primary hover:text-on-primary transition-all active:scale-95 shadow-sm border border-outline-variant/20 shrink-0 min-h-[36px]"
                    data-cat-id={cat.id}
                    data-cat-name={cat.name}
                    data-cat-amount={cat.monthlyLimit}
                  >
                    Registrar Pago
                  </button>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Acceso directo a Vista Completa de Pagos -->
        <a
          href="/pagos"
          class="w-full py-2.5 px-3 rounded-xl bg-surface-container text-primary hover:bg-primary hover:text-on-primary text-xs font-bold flex items-center justify-center gap-1.5 transition-all shadow-sm border border-primary/20 active:scale-95"
        >
          <span>Abrir vista completa de Pagos Programados</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
      </section>

      <!-- Nota Informativa de Liquidez Congelada -->
      <div class="liquid-glass p-3.5 rounded-2xl flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[18px]">verified_user</span>
        </div>
        <p class="text-[11px] text-on-surface-variant leading-relaxed">
          Estos pagos son obligatorios e inamovibles. La app descuenta automáticamente <strong class="text-on-surface">L. 8,750</strong> de tu salario desde el día 1.
        </p>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 3. VISTA: GASTOS VARIABLES (LÍMITES) -->
    <!-- ========================================== -->
    <div id="panel-categorias" class="view-panel hidden space-y-3.5 transition-opacity duration-300">
      <section id="section-expenses" class="flex flex-col gap-2.5">
        <div class="flex items-center justify-between px-1">
          <h2 class="font-bold text-sm text-on-surface tracking-tight font-headline">
            Distribución por categoría
          </h2>
          <span class="text-[11px] text-secondary font-medium">Límites Estrictos</span>
        </div>

        <div class="liquid-glass-card rounded-2xl p-4 flex flex-col gap-3.5 border border-outline-variant/20 shadow-md">
          {variableCategories.map((cat) => (
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-center text-xs">
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[18px] text-tertiary">
                    {cat.materialIcon}
                  </span>
                  <span class="font-semibold text-on-surface">{cat.name}</span>
                  {cat.isOcioDanger && (
                    <span class="text-[9px] text-error font-bold bg-error/15 px-1.5 py-0.5 rounded-full animate-pulse border border-error/20">
                      &gt; L. 1,000
                    </span>
                  )}
                </div>
                <span class="font-medium text-on-surface tabular-nums">
                  L. {cat.currentSpent.toFixed(0)}{' '}
                  <span class="text-on-surface-variant font-normal">
                    / L. {cat.monthlyLimit.toFixed(0)}
                  </span>
                </span>
              </div>

              <!-- Barra de progreso orgánica sutil -->
              <div class="w-full bg-surface-container-lowest h-1.5 rounded-full overflow-hidden">
                <div
                  class={`${cat.barColorClass} h-full rounded-full transition-all duration-500`}
                  style={`width: ${cat.percentage}%`}
                ></div>
              </div>

              {cat.isHardStopTriggered && (
                <div class="text-[10px] text-error font-semibold flex items-center gap-1 bg-error/10 p-1.5 rounded-lg border border-error/20">
                  <span class="material-symbols-outlined text-[13px]">block</span>
                  <span>Hard Stop Activo: Límite mensual agotado. Compras bloqueadas.</span>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- ========================================== -->
    <!-- 4. VISTA: FUGAS A CORTAR (SUSCRIPCIONES) -->
    <!-- ========================================== -->
    <div id="panel-fugas" class="view-panel hidden space-y-3.5 transition-opacity duration-300">
      <!-- CHECKLIST: FUGAS A CORTAR HOY (SUSCRIPCIONES) -->
      <section id="section-checklist" class="liquid-glass-card rounded-2xl p-4 border border-outline-variant/20 shadow-md flex flex-col gap-3">
        <div class="flex justify-between items-center">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-error-container/30 text-error flex items-center justify-center">
              <span class="material-symbols-outlined text-[18px]">content_cut</span>
            </div>
            <div>
              <h3 class="font-bold text-sm text-on-surface tracking-tight font-headline">
                Fugas a Cortar Hoy
              </h3>
              <p class="text-[10px] text-on-surface-variant">
                Marca las suscripciones al cancelarlas para recuperar liquidez:
              </p>
            </div>
          </div>
          <span class="badge badge-error text-error-content text-[10px] font-bold px-2 py-0.5">
