        </div>

        <div class="space-y-1.5" id="leaks-checklist">
          <!-- Item 1 -->
          <label class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low/70 border border-outline-variant/15 cursor-pointer hover:bg-surface-container-high transition-colors">
            <input
              type="checkbox"
              data-leak-id="nanonoble"
              class="checkbox checkbox-error checkbox-sm rounded-md"
            />
            <div class="flex-1 flex justify-between items-center text-xs">
              <span class="font-medium text-on-surface leak-title">Cancelar Nanonoble</span>
