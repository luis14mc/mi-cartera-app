---
import Layout from '../layouts/Layout.astro';
import { db, schema } from '../db';
import { eq, and, gte, lte, desc } from 'drizzle-orm';

export const prerender = false;

// Parámetros financieros estrictos de Control CRONOS
const MONTHLY_SALARY = 26518.0;
const FIXED_DEBT_AMOUNT = 4400.0;
const DEBT_DUE_DAY = 20;

// Lógica de detección de fecha para Alerta Proactiva (Días 17 al 20)
const now = new Date();
const currentDay = now.getDate();
const isDebtAlertActive = currentDay >= 17 && currentDay <= DEBT_DUE_DAY;

interface CategoryCard {
  id: number;
  name: string;
  monthlyLimit: number;
  currentSpent: number;
  remaining: number;
  percentage: number;
  progressClass: string;
  badgeClass: string;
  icon: string;
  isLeakWarning: boolean;
}

let dbConfigured = true;
let categoriesList: CategoryCard[] = [];
let totalSpent = 0;
let totalBudget = 0;
let recentTransactions: Array<{
  id: number;
  amount: string;
  description: string;
  categoryName: string;
  icon: string;
  formattedDate: string;
}> = [];

try {
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0, 0);
  const endOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59, 999);

  // 1. Consultar categorías desde Neon
  const rawCategories = await db.select().from(schema.categories);

  for (const cat of rawCategories) {
    const catTransactions = await db
      .select({ amount: schema.transactions.amount })
      .from(schema.transactions)
      .where(
        and(
          eq(schema.transactions.category_id, cat.id),
          gte(schema.transactions.date, startOfMonth),
          lte(schema.transactions.date, endOfMonth)
        )
      );

    const spent = catTransactions.reduce((acc, t) => acc + parseFloat(t.amount || '0'), 0);
    const limit = parseFloat(cat.monthly_limit);
    const remaining = Math.max(0, limit - spent);
    const percentage = limit > 0 ? Math.min(Math.round((spent / limit) * 100), 100) : 0;

    // Clasificación de color según requerimiento:
    // > 85%: progress-error | > 60%: progress-warning | < 60%: progress-success
    let progressClass = 'progress-success';
    let badgeClass = 'badge-success text-success-content font-bold';

    if (percentage > 85) {
      progressClass = 'progress-error';
      badgeClass = 'badge-error text-error-content font-extrabold';
    } else if (percentage > 60) {
      progressClass = 'progress-warning';
      badgeClass = 'badge-warning text-warning-content font-bold';
    }

    const isLeak = cat.name.toLowerCase().includes('suscrip') || cat.name.toLowerCase().includes('hormiga');

    categoriesList.push({
      id: cat.id,
      name: cat.name,
      monthlyLimit: limit,
      currentSpent: spent,
      remaining,
      percentage,
      progressClass,
      badgeClass,
      icon: cat.icon || '📌',
      isLeakWarning: isLeak,
    });

    totalBudget += limit;
    totalSpent += spent;
  }

  // 2. Transacciones recientes
  const rawTransactions = await db
    .select({
      id: schema.transactions.id,
      amount: schema.transactions.amount,
      description: schema.transactions.description,
      date: schema.transactions.date,
      categoryName: schema.categories.name,
      icon: schema.categories.icon,
    })
    .from(schema.transactions)
    .leftJoin(schema.categories, eq(schema.transactions.category_id, schema.categories.id))
    .orderBy(desc(schema.transactions.date))
    .limit(5);

  recentTransactions = rawTransactions.map((t) => ({
    id: t.id,
    amount: parseFloat(t.amount).toFixed(2),
    description: t.description || 'Gasto registrado',
    categoryName: t.categoryName || 'General',
    icon: t.icon || '🏷️',
    formattedDate: new Date(t.date).toLocaleDateString('es-HN', { day: 'numeric', month: 'short' }),
  }));
} catch (error) {
  dbConfigured = false;
  categoriesList = [
    {
      id: 1,
      name: 'Suscripciones & Software',
      monthlyLimit: 1200.0,
      currentSpent: 1080.0,
      remaining: 120.0,
      percentage: 90,
      progressClass: 'progress-error',
      badgeClass: 'badge-error text-error-content font-extrabold',
      icon: '💻',
      isLeakWarning: true,
    },
    {
      id: 2,
      name: 'Gastos Hormiga (Café/Snacks)',
      monthlyLimit: 1500.0,
      currentSpent: 990.0,
      remaining: 510.0,
      percentage: 66,
      progressClass: 'progress-warning',
      badgeClass: 'badge-warning text-warning-content font-bold',
      icon: '🐜',
      isLeakWarning: true,
    },
    {
      id: 3,
      name: 'Básico y Supermercado',
      monthlyLimit: 7500.0,
      currentSpent: 3200.0,
      remaining: 4300.0,
      percentage: 42,
      progressClass: 'progress-success',
      badgeClass: 'badge-success text-success-content font-bold',
      icon: '🛒',
      isLeakWarning: false,
    },
    {
      id: 4,
      name: 'Transporte y Gasolina',
      monthlyLimit: 3000.0,
      currentSpent: 1650.0,
      remaining: 1350.0,
      percentage: 55,
      progressClass: 'progress-success',
      badgeClass: 'badge-success text-success-content font-bold',
      icon: '⛽',
      isLeakWarning: false,
    },
  ];
  totalBudget = 13200.0;
  totalSpent = 6920.0;
}

const currentMonthLabel = now.toLocaleDateString('es-HN', { month: 'long', year: 'numeric' });
const disposableSalary = MONTHLY_SALARY - FIXED_DEBT_AMOUNT - totalSpent;
---

<Layout title="Control CRONOS">
  <!-- ALERTA PROACTIVA OBLIGATORIA (Días 17 al 20) -->
  {isDebtAlertActive && (
    <div class="alert alert-warning shadow-xl mb-4 flex items-start gap-2.5 border-l-4 border-warning text-warning-content animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6 mt-0.5" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <h4 class="font-extrabold text-sm uppercase tracking-wide">¡Compromiso Crítico!</h4>
        <p class="text-xs font-bold leading-snug">
          ¡Atención! Separa L. 4,400 para tarjetas/préstamo el día 20.
        </p>
      </div>
    </div>
  )}

  <!-- Banner Informativo de Conexión a Neon si no está conectada -->
  {!dbConfigured && (
    <div class="alert alert-info shadow-sm mb-4 text-xs py-2 text-info-content">
      <span>💡 Modo local de demostración. Configura <code class="font-bold">DATABASE_URL</code> en <code class="font-bold">.env</code> para sincronizar con Neon.</span>
    </div>
  )}

  <!-- Tarjeta Resumen Financiero: Salario & Control Global (Forest Palette) -->
  <section class="card bg-base-200 border border-base-300 shadow-2xl mb-5 text-base-content overflow-hidden">
    <div class="card-body p-4.5">
      <div class="flex justify-between items-start">
        <div>
          <span class="text-[11px] font-bold tracking-wider text-primary uppercase">Salario Mensual</span>
          <h2 class="text-2xl font-black tracking-tight text-base-content mt-0.5">
            L. {MONTHLY_SALARY.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
          </h2>
        </div>
        <div class="badge badge-primary text-primary-content font-extrabold text-xs py-2 px-2.5">
          {currentMonthLabel}
        </div>
      </div>

      <!-- Métricas Clave -->
      <div class="grid grid-cols-2 gap-2 mt-3 pt-3 border-t border-base-300 text-xs">
        <div class="bg-base-300/60 p-2.5 rounded-xl border border-base-content/5">
          <span class="text-base-content/60 block text-[10px] font-semibold">Deuda Fija (Día 20):</span>
          <span class="font-extrabold text-warning">L. {FIXED_DEBT_AMOUNT.toLocaleString('es-HN', { minimumFractionDigits: 2 })}</span>
        </div>
        <div class="bg-base-300/60 p-2.5 rounded-xl border border-base-content/5">
          <span class="text-base-content/60 block text-[10px] font-semibold">Gastado en el Mes:</span>
          <span class="font-extrabold text-error">L. {totalSpent.toLocaleString('es-HN', { minimumFractionDigits: 2 })}</span>
        </div>
      </div>

      <div class="mt-2.5 text-center text-xs text-base-content/80 font-medium bg-primary/10 py-1.5 px-2 rounded-xl border border-primary/20">
        Saldo Libre Estimado: <strong class="text-primary font-black">L. {disposableSalary.toLocaleString('es-HN', { minimumFractionDigits: 2 })}</strong>
      </div>
    </div>
  </section>

  <!-- Dashboard de Categorías con Barras de Progreso DaisyUI -->
  <section class="mb-6">
    <div class="flex justify-between items-center mb-3">
      <h3 class="font-extrabold text-sm text-base-content flex items-center gap-1.5 uppercase tracking-wide">
        🛡️ Categorías & Bloqueos Duros
      </h3>
      <span class="text-[11px] text-base-content/60 font-semibold">{categoriesList.length} Categorías</span>
    </div>

    <div class="space-y-3">
      {categoriesList.map((cat) => (
        <div class="card bg-base-200 border border-base-300 shadow-md p-3.5 hover:border-primary/40 transition-all">
          <div class="flex justify-between items-center mb-1.5">
            <div class="flex items-center gap-2">
              <span class="text-lg">{cat.icon}</span>
              <div>
                <span class="font-bold text-sm text-base-content block leading-tight">{cat.name}</span>
                {cat.isLeakWarning && (
                  <span class="badge badge-error text-error-content text-[9px] py-0 px-1.5 font-black">Fuga Detectada</span>
                )}
              </div>
            </div>
            <span class={`badge badge-sm ${cat.badgeClass}`}>
              {cat.percentage}%
            </span>
          </div>

          <!-- Barra de Progreso DaisyUI -->
          <!-- > 85%: progress-error | > 60%: progress-warning | < 60%: progress-success -->
          <progress
            class={`progress ${cat.progressClass} w-full h-2.5 my-1.5`}
            value={cat.currentSpent}
            max={cat.monthlyLimit}
          ></progress>

          <div class="flex justify-between items-center text-xs text-base-content/70 font-medium mt-0.5">
            <span>Gastado: <strong class="text-base-content font-bold">L. {cat.currentSpent.toFixed(2)}</strong></span>
            <span>Límite: L. {cat.monthlyLimit.toFixed(2)}</span>
          </div>

          {cat.percentage >= 100 && (
            <div class="text-[10px] text-error font-extrabold mt-1.5 flex items-center gap-1 bg-error/15 p-1.5 rounded-lg border border-error/30">
              🛑 <span>Hard Stop Activo: No se permiten más gastos en esta categoría.</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Historial Reciente de Gastos -->
  {recentTransactions.length > 0 && (
    <section class="mb-4">
      <h3 class="font-extrabold text-sm text-base-content flex items-center gap-1.5 uppercase tracking-wide mb-2.5">
        ⏱️ Últimos Movimientos
      </h3>
      <div class="space-y-2">
        {recentTransactions.map((item) => (
          <div class="card bg-base-200 border border-base-300 shadow-sm p-3 flex flex-row items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="text-base">{item.icon}</span>
              <div>
                <p class="font-bold text-xs text-base-content leading-tight">{item.description}</p>
                <p class="text-[10px] text-base-content/60">{item.categoryName} • {item.formattedDate}</p>
              </div>
            </div>
            <span class="font-extrabold text-xs text-primary">L. {item.amount}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Floating Action Button (FAB) Fijo Abajo a la Derecha -->
  <button
    id="btn-open-fab"
    type="button"
    class="btn btn-circle btn-primary text-primary-content shadow-2xl fixed bottom-6 right-6 z-40 text-2xl font-black hover:scale-110 active:scale-95 transition-transform"
    title="Registrar Gasto Rápido"
  >
    +
  </button>

  <!-- Dialog / Bottom Sheet Modal de DaisyUI -->
  <dialog id="modal_quick_expense" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box p-5 bg-base-200 border border-base-300 text-base-content max-w-md mx-auto shadow-2xl">
      <div class="flex justify-between items-center mb-3">
        <h3 class="font-black text-base text-base-content flex items-center gap-1.5">
          ⚡ Registrar Gasto Rápido
        </h3>
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost text-base-content/60">✕</button>
        </form>
      </div>

      <form id="cronos-transaction-form" class="space-y-4">
        <!-- Input de Número Gigante -->
        <div class="form-control text-center py-2">
          <label class="label-text text-xs text-base-content/60 uppercase font-bold tracking-wider mb-1 block">
            Monto a Registrar
          </label>
          <div class="flex items-center justify-center">
            <span class="text-3xl font-black text-primary mr-1">L.</span>
            <input
              type="number"
              id="quick_amount"
              name="amount"
              step="0.01"
              min="0.01"
              placeholder="0.00"
              required
              class="text-4xl text-center font-black input input-ghost w-48 border-b-2 border-primary focus:outline-none focus:border-primary text-base-content"
            />
          </div>
        </div>

        <!-- Selector de Categorías -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-bold text-base-content">Categoría</span>
          </label>
          <select id="quick_category_id" name="category_id" required class="select select-bordered select-sm w-full bg-base-100 text-base-content font-semibold">
            <option value="" disabled selected>Selecciona categoría...</option>
            {categoriesList.map((c) => (
              <option value={c.id}>
                {c.icon} {c.name} (Disponible: L. {c.remaining.toFixed(2)})
              </option>
            ))}
          </select>
        </div>

        <!-- Descripción -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-bold text-base-content">Descripción</span>
          </label>
          <input
            type="text"
            id="quick_description"
            name="description"
            placeholder="Ej. Café, suscripción, almuerzo..."
            class="input input-bordered input-sm w-full bg-base-100 text-base-content font-medium"
          />
        </div>

        <!-- Botón de Envío -->
        <button
          type="submit"
          id="btn-submit-quick"
          class="btn btn-primary text-primary-content btn-block font-extrabold normal-case text-sm mt-3 shadow-lg"
        >
          <span id="btn-quick-text">Aplicar Gasto</span>
          <span id="btn-quick-spinner" class="loading loading-spinner loading-xs hidden"></span>
        </button>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
</Layout>

<script>
  // Control del Dialog / Bottom Sheet Modal
  const modal = document.getElementById('modal_quick_expense') as HTMLDialogElement;
  const btnOpenFab = document.getElementById('btn-open-fab') as HTMLButtonElement;
  const form = document.getElementById('cronos-transaction-form') as HTMLFormElement;
  const amountInput = document.getElementById('quick_amount') as HTMLInputElement;
  const categorySelect = document.getElementById('quick_category_id') as HTMLSelectElement;
  const descriptionInput = document.getElementById('quick_description') as HTMLInputElement;
  const btnSubmit = document.getElementById('btn-submit-quick') as HTMLButtonElement;
  const btnText = document.getElementById('btn-quick-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-quick-spinner') as HTMLSpanElement;
  const toastContainer = document.getElementById('toast-container') as HTMLDivElement;

  btnOpenFab?.addEventListener('click', () => {
    modal.showModal();
    setTimeout(() => amountInput?.focus(), 150);
  });

  // Mostrar Toast Nativo de DaisyUI
  function showDaisyToast(message: string, isError: boolean = false) {
    if (!toastContainer) return;

    const toastDiv = document.createElement('div');
    toastDiv.className = `alert ${isError ? 'alert-error text-error-content' : 'alert-success text-success-content'} shadow-2xl text-xs font-extrabold flex items-center gap-2 pointer-events-auto transition-all animate-bounce border border-base-content/20`;
    toastDiv.innerHTML = `
      <span>${isError ? '🛑' : '✅'}</span>
      <span>${message}</span>
    `;

    toastContainer.appendChild(toastDiv);

    setTimeout(() => {
      toastDiv.classList.remove('animate-bounce');
      toastDiv.classList.add('opacity-0', 'scale-90');
      setTimeout(() => toastDiv.remove(), 300);
    }, 3500);
  }

  // Envío del Formulario
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const amount = parseFloat(amountInput.value);
    const category_id = parseInt(categorySelect.value);
    const description = descriptionInput.value.trim();

    if (isNaN(amount) || amount <= 0 || isNaN(category_id)) {
      showDaisyToast('Por favor completa todos los campos requeridos.', true);
      return;
    }

    btnSubmit.disabled = true;
    btnText.textContent = 'Verificando Hard Stop...';
    btnSpinner.classList.remove('hidden');

    try {
      const response = await fetch('/api/transactions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount,
          category_id,
          description,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        // HTTP 400: Límite excedido. Transacción bloqueada.
        showDaisyToast(data.error || 'Límite excedido. Transacción bloqueada.', true);
      } else {
        // HTTP 200: Éxito
        showDaisyToast('Transacción registrada exitosamente.', false);
        form.reset();
        modal.close();
        setTimeout(() => window.location.reload(), 1000);
      }
    } catch (err) {
      showDaisyToast('Error de red al procesar transacción.', true);
    } finally {
      btnSubmit.disabled = false;
      btnText.textContent = 'Aplicar Gasto';
      btnSpinner.classList.add('hidden');
    }
  });
</script>
