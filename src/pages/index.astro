        <!-- Selector de Categoría -->
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-on-surface-variant ml-1" for="quick_category_id">
            Categoría
          </label>
          <div class="relative flex items-center">
            <select
              id="quick_category_id"
              name="category_id"
              required
              class="w-full bg-surface-container-low text-on-surface rounded-full py-2.5 px-4 text-xs font-semibold appearance-none focus:outline-none focus:bg-surface-container-high border border-outline-variant/15 pr-8"
            >
              <option value="" disabled selected>Selecciona categoría...</option>
              <optgroup label="🔒 Compromisos Intocables">
                {untouchableCommitments.map((c) => (
                  <option value={c.id}>
                    {c.icon} {c.name} (L. {c.monthlyLimit.toFixed(2)})
                  </option>
                ))}
              </optgroup>
              <optgroup label="🛡️ Gastos Variables">
                {variableCategories.map((c) => (
                  <option value={c.id}>
                    {c.icon} {c.name} (Disponible: L. {c.remaining.toFixed(2)})
                  </option>
                ))}
              </optgroup>
            </select>
            <span class="material-symbols-outlined absolute right-3 pointer-events-none text-on-surface-variant text-[18px]">
              expand_more
            </span>
          </div>
        </div>

        <!-- Concepto o Establecimiento -->
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-on-surface-variant ml-1" for="quick_description">
            Concepto
          </label>
          <div class="flex items-center bg-surface-container-low rounded-full px-4 py-2.5 border border-outline-variant/15">
            <span class="material-symbols-outlined text-outline text-[18px] mr-2">store</span>
            <input
              type="text"
              id="quick_description"
              name="description"
              placeholder="Ej. Supermercado, combustible, café..."
              class="w-full bg-transparent text-xs text-on-surface placeholder:text-outline focus:outline-none font-medium"
            />
          </div>
        </div>

        <!-- Botón Primario de Guardado Forest -->
        <button
          type="submit"
          id="btn-submit-quick"
          class="w-full h-12 rounded-full bg-primary text-on-primary font-bold text-xs flex items-center justify-center gap-2 hover:brightness-110 active:scale-[0.98] transition-all shadow-[0_4px_16px_rgba(30,184,84,0.3)] mt-2"
        >
          <span class="material-symbols-outlined text-[19px]">cloud_done</span>
          <span id="btn-quick-text">Guardar transacción</span>
          <span id="btn-quick-spinner" class="loading loading-spinner loading-xs hidden"></span>
        </button>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <!-- MODAL DE ADVERTENCIA ROJA: BLOQUEO DE PLÁSTICO (INTERCEPCIÓN) -->
  <dialog id="modal_plastic_warning" class="modal modal-bottom sm:modal-middle" aria-labelledby="modal_plastic_title" aria-modal="true">
    <div class="modal-box p-5 bg-surface-container border-2 border-error text-on-surface max-w-md mx-auto shadow-2xl rounded-t-3xl sm:rounded-3xl">
      <div class="flex items-start gap-3">
        <div class="w-12 h-12 rounded-2xl bg-error-container/30 text-error flex items-center justify-center text-2xl font-black shrink-0 border border-error/30 animate-pulse">
          <span class="material-symbols-outlined text-[26px]">block</span>
        </div>
        <div>
          <h3 id="modal_plastic_title" class="font-extrabold text-base text-error uppercase tracking-tight font-headline">
            ¡ALTO LUIS!
          </h3>
          <p class="text-xs text-on-surface font-medium mt-1 leading-relaxed">
            Perdiste tu periodo de gracia este mes. Si pasas la tarjeta por <strong class="text-error font-bold text-sm">L. <span id="warning_card_amount">0.00</span></strong>, el banco te cobrará intereses desde HOY. Usa Débito o cancela la compra.
          </p>
        </div>
      </div>

      <div class="divider my-3 border-outline-variant/10"></div>

      <div class="flex flex-col gap-2 mt-1">
        <button
          type="button"
          id="btn-plastic-cancel"
          class="btn btn-primary text-on-primary rounded-full font-bold text-xs normal-case shadow-md h-11"
        >
          <span class="material-symbols-outlined text-[18px]">check_circle</span>
          Cambiar a Débito / Efectivo (Recomendado)
        </button>
        <button
          type="button"
          id="btn-plastic-confirm"
          class="btn btn-outline btn-error btn-xs rounded-full font-medium text-[11px] normal-case opacity-75 hover:opacity-100 py-2 h-auto"
        >
          Confirmar bajo mi propio riesgo
        </button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
</Layout>

<script>
  // ========================================================
  // CONTROL DE VISTAS SEGMENTADAS (EVITA VISTA EN UN SOLO CHORIZO)
  // ========================================================
  function switchDashboardView(targetView: string, updateUrl: boolean = true) {
    const panels: Record<string, HTMLElement | null> = {
      resumen: document.getElementById('panel-resumen'),
      compromisos: document.getElementById('panel-compromisos'),
      categorias: document.getElementById('panel-categorias'),
      fugas: document.getElementById('panel-fugas'),
    };

    const tabButtons = document.querySelectorAll('.view-tab-btn');
    tabButtons.forEach((btn) => {
      const v = btn.getAttribute('data-view');
      if (v === targetView) {
        btn.className = 'view-tab-btn flex-1 min-w-[76px] py-1.5 px-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-1 transition-all active:scale-95 bg-primary text-on-primary shadow-[0_2px_10px_rgba(30,184,84,0.35),inset_0_1px_0_rgba(255,255,255,0.25)] scale-[1.02]';
      } else {
        btn.className = 'view-tab-btn flex-1 min-w-[76px] py-1.5 px-2.5 rounded-xl text-xs font-medium text-on-surface-variant hover:text-on-surface hover:bg-white/5 flex items-center justify-center gap-1 transition-all active:scale-95';
      }
    });

    if (targetView === 'todo') {
      Object.values(panels).forEach((p) => {
        p?.classList.remove('hidden');
      });
    } else {
      Object.entries(panels).forEach(([key, panel]) => {
        if (key === targetView) {
          panel?.classList.remove('hidden');
        } else {
          panel?.classList.add('hidden');
        }
      });
    }

    if (updateUrl && window.history.replaceState) {
      const url = new URL(window.location.href);
      url.searchParams.set('tab', targetView);
      window.history.replaceState({}, '', url.toString());
    }
  }

  // Hacer accesible globalmente
  (window as any).switchDashboardView = switchDashboardView;

  // Escuchar clics en los botones de pestaña
  document.querySelectorAll('.view-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const v = btn.getAttribute('data-view');
      if (v) switchDashboardView(v);
    });
  });

  // Detectar tab inicial por URL param o hash
  const initialUrlParams = new URLSearchParams(window.location.search);
  const tabParam = initialUrlParams.get('tab');
  const hash = window.location.hash;

  if (tabParam && ['resumen', 'compromisos', 'categorias', 'fugas', 'todo'].includes(tabParam)) {
    switchDashboardView(tabParam, false);
  } else if (hash.includes('commitments')) {
    switchDashboardView('compromisos', false);
  } else if (hash.includes('expenses')) {
    switchDashboardView('categorias', false);
  } else if (hash.includes('checklist')) {
    switchDashboardView('fugas', false);
  } else {
    switchDashboardView('resumen', false);
  }

  // Escuchar hashchange
  window.addEventListener('hashchange', () => {
    if (window.location.hash.includes('commitments')) switchDashboardView('compromisos', false);
    else if (window.location.hash.includes('expenses')) switchDashboardView('categorias', false);
  });

  // Control del Checklist "Fugas a Cortar Hoy" (Persistencia en LocalStorage)
  const checklistContainer = document.getElementById('leaks-checklist');
  const LEAKS_STORAGE_KEY = 'cronos_survival_cancelled_leaks_v2';

  function initChecklist() {
    let savedState: Record<string, boolean> = {};
    try {
      const raw = localStorage.getItem(LEAKS_STORAGE_KEY);
      if (raw) savedState = JSON.parse(raw);
    } catch (e) {
      console.warn('Error leyendo checklist de localStorage');
    }

    const checkboxes = checklistContainer?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
    checkboxes?.forEach((cb) => {
      const leakId = cb.getAttribute('data-leak-id');
      const labelSpan = cb.closest('label')?.querySelector('.leak-title');

      if (leakId && savedState[leakId]) {
        cb.checked = true;
        labelSpan?.classList.add('line-through', 'opacity-50');
      }

      cb.addEventListener('change', () => {
        if (!leakId) return;
        savedState[leakId] = cb.checked;
        try {
          localStorage.setItem(LEAKS_STORAGE_KEY, JSON.stringify(savedState));
        } catch (e) {}

        if (cb.checked) {
          labelSpan?.classList.add('line-through', 'opacity-50');
          showDaisyToast('¡Fuga cancelada! Ahorro mensual asegurado.', false);
        } else {
          labelSpan?.classList.remove('line-through', 'opacity-50');
        }
      });
    });
  }

  initChecklist();

  // Control de Modales y Formulario
  const modalQuick = document.getElementById('modal_quick_expense') as HTMLDialogElement;
  const modalPlastic = document.getElementById('modal_plastic_warning') as HTMLDialogElement;
  const btnOpenFab = document.getElementById('btn-open-fab') as HTMLButtonElement;
  const form = document.getElementById('cronos-transaction-form') as HTMLFormElement;
  const amountInput = document.getElementById('quick_amount') as HTMLInputElement;
  const categorySelect = document.getElementById('quick_category_id') as HTMLSelectElement;
  const descriptionInput = document.getElementById('quick_description') as HTMLInputElement;
  const btnSubmit = document.getElementById('btn-submit-quick') as HTMLButtonElement;
  const btnText = document.getElementById('btn-quick-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-quick-spinner') as HTMLSpanElement;
  const toastContainer = document.getElementById('toast-container') as HTMLDivElement;

  const warningCardAmount = document.getElementById('warning_card_amount') as HTMLSpanElement;
  const btnPlasticCancel = document.getElementById('btn-plastic-cancel') as HTMLButtonElement;
  const btnPlasticConfirm = document.getElementById('btn-plastic-confirm') as HTMLButtonElement;
  const pmDebito = document.getElementById('pm_debito') as HTMLInputElement;
  const pmCredito = document.getElementById('pm_credito') as HTMLInputElement;

  let plasticRiskAccepted = false;

  btnOpenFab?.addEventListener('click', () => {
    modalQuick.showModal();
    plasticRiskAccepted = false;
    setTimeout(() => amountInput?.focus(), 150);
  });

  // Botones de "Registrar Pago" de Compromisos Intocables (Un solo clic)
  const payCommitmentBtns = document.querySelectorAll<HTMLButtonElement>('.btn-pay-commitment');
  payCommitmentBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const catId = parseInt(btn.dataset.catId || '0');
      const catName = btn.dataset.catName || 'Compromiso Fijo';
      const amount = parseFloat(btn.dataset.catAmount || '0');

      if (!catId || isNaN(amount) || amount <= 0) return;

      const confirmed = confirm(
        `¿Confirmas el registro del pago de ${catName} por L. ${amount.toFixed(2)} (vía Débito/Efectivo)?`
      );
      if (!confirmed) return;

      btn.disabled = true;
      btn.innerHTML = `<span class="loading loading-spinner loading-xs"></span> Registrando...`;

      try {
        const response = await fetch('/api/transactions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            amount,
            category_id: catId,
            description: `Pago mensual ${catName}`,
            payment_method: 'DEBITO_EFECTIVO',
          }),
        });

        const data = await response.json();
        if (!response.ok) {
          showDaisyToast(data.error || 'Error al registrar pago', true);
          btn.disabled = false;
          btn.textContent = 'Registrar Pago';
        } else {
          showDaisyToast(`¡${catName} registrado como PAGADO!`, false);
          setTimeout(() => window.location.reload(), 1000);
        }
      } catch (err) {
        showDaisyToast('Error de red al registrar pago.', true);
        btn.disabled = false;
        btn.textContent = 'Registrar Pago';
      }
    });
  });

  // Mostrar Toast Nativo de DaisyUI
  function showDaisyToast(message: string, isError: boolean = false) {
    if (!toastContainer) return;

    const toastDiv = document.createElement('div');
    toastDiv.className = `alert ${isError ? 'alert-error text-error-content' : 'alert-success text-success-content'} shadow-2xl text-xs font-semibold flex items-center gap-2 pointer-events-auto transition-all animate-bounce border border-outline-variant/30 rounded-2xl`;
    toastDiv.innerHTML = `
      <span class="material-symbols-outlined text-[18px]">${isError ? 'error' : 'check_circle'}</span>
      <span>${message}</span>
    `;

    toastContainer.appendChild(toastDiv);

    setTimeout(() => {
      toastDiv.classList.remove('animate-bounce');
      toastDiv.classList.add('opacity-0', 'scale-90');
      setTimeout(() => toastDiv.remove(), 300);
    }, 4000);
  }

  // Botón Cancelar del Modal de Plástico -> Cambiar a Débito
  btnPlasticCancel?.addEventListener('click', () => {
    modalPlastic.close();
    if (pmDebito) pmDebito.checked = true;
    plasticRiskAccepted = false;
    showDaisyToast('Método cambiado a Débito/Efectivo para protegerte de intereses.', false);
  });

  // Botón Confirmar del Modal de Plástico -> Proceder bajo propio riesgo
  btnPlasticConfirm?.addEventListener('click', () => {
    plasticRiskAccepted = true;
    modalPlastic.close();
    executeSubmit();
  });

  // Envío del Formulario
  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const amount = parseFloat(amountInput.value);
    const category_id = parseInt(categorySelect.value);

    if (isNaN(amount) || amount <= 0 || isNaN(category_id)) {
      showDaisyToast('Por favor ingresa un monto válido y selecciona una categoría.', true);
      return;
    }

    const selectedPaymentMethod = pmCredito?.checked ? 'TARJETA_CREDITO' : 'DEBITO_EFECTIVO';

    // 🛑 REGLA DE INTERCEPCIÓN: BLOQUEO DE PLÁSTICO
    if (selectedPaymentMethod === 'TARJETA_CREDITO' && !plasticRiskAccepted) {
      if (warningCardAmount) {
        warningCardAmount.textContent = amount.toLocaleString('es-HN', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });
      }
      modalPlastic.showModal();
      return;
    }

    executeSubmit();
  });

  async function executeSubmit() {
    const amount = parseFloat(amountInput.value);
    const category_id = parseInt(categorySelect.value);
    const description = descriptionInput.value.trim();
    const payment_method = pmCredito?.checked ? 'TARJETA_CREDITO' : 'DEBITO_EFECTIVO';

    btnSubmit.disabled = true;
    btnText.textContent = 'Verificando Hard Stop...';
    btnSpinner.classList.remove('hidden');

    try {
      const response = await fetch('/api/transactions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount,
          category_id,
          description,
          payment_method,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        // Bloqueo 400 Bad Request
        showDaisyToast(data.error || 'Límite excedido. Transacción bloqueada.', true);
      } else {
        // HTTP 200: Éxito
        showDaisyToast('Gasto registrado con éxito.', false);
        form.reset();
        plasticRiskAccepted = false;
        modalQuick.close();
        setTimeout(() => window.location.reload(), 1000);
      }
    } catch (err) {
      showDaisyToast('Error de red al registrar la transacción.', true);
    } finally {
      btnSubmit.disabled = false;
      btnText.textContent = 'Guardar transacción';
      btnSpinner.classList.add('hidden');
      plasticRiskAccepted = false;
    }
  }
</script>
