---
import Layout from '../layouts/Layout.astro';
import { db, schema } from '../db';
import { eq, and, gte, lte, desc } from 'drizzle-orm';

export const prerender = false;

// Parámetros financieros del MODO SUPERVIVENCIA (Octubre)
const MONTHLY_SALARY = 26518.0;
const UNTOUCHABLE_COMMITMENTS_TOTAL = 8750.0; // Maestría (4,350) + Deudas Fijas (4,400)
const DEBT_DUE_DAY = 20;

// Lógica de detección de fecha para Alerta Proactiva (Días 17 al 20)
const now = new Date();
const currentDay = now.getDate();
const isDebtAlertActive = currentDay >= 17 && currentDay <= DEBT_DUE_DAY;

interface CategoryItem {
  id: number;
  name: string;
  monthlyLimit: number;
  currentSpent: number;
  remaining: number;
  percentage: number;
  progressClass: string;
  badgeClass: string;
  icon: string;
  isOcioDanger: boolean;
  isHardStopTriggered: boolean;
  isUntouchable: boolean;
  isPaid: boolean;
}

let dbConfigured = true;
let untouchableCommitments: CategoryItem[] = [];
let variableCategories: CategoryItem[] = [];
let totalVariableSpent = 0;
let totalUntouchableSpent = 0;
let allCategories: CategoryItem[] = [];
let recentTransactions: Array<{
  id: number;
  amount: string;
  description: string;
  paymentMethod: string;
  categoryName: string;
  icon: string;
  formattedDate: string;
}> = [];

try {
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0, 0);
  const endOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59, 999);

  // 1. Consultar categorías desde Neon
  const rawCategories = await db.select().from(schema.categories);

  for (const cat of rawCategories) {
    const catTransactions = await db
      .select({ amount: schema.transactions.amount })
      .from(schema.transactions)
      .where(
        and(
          eq(schema.transactions.category_id, cat.id),
          gte(schema.transactions.date, startOfMonth),
          lte(schema.transactions.date, endOfMonth)
        )
      );

    const spent = catTransactions.reduce((acc, t) => acc + parseFloat(t.amount || '0'), 0);
    const limit = parseFloat(cat.monthly_limit);
    const remaining = Math.max(0, limit - spent);
    const percentage = limit > 0 ? Math.min(Math.round((spent / limit) * 100), 100) : 0;

    const lowerName = cat.name.toLowerCase();
    const isUntouchable =
      lowerName.includes('maestr') || lowerName.includes('deuda') || lowerName.includes('préstamo');
    const isOcio = lowerName.includes('ocio') || lowerName.includes('hormiga');

    // Regla de Negocio: En "Ocio y Hormiga", si supera L. 1,000 se vuelve ROJO inmediatamente
    let progressClass = 'progress-success';
    let badgeClass = 'badge-success text-success-content font-bold';
    const isOcioDanger = isOcio && spent > 1000;

    if (isOcioDanger || percentage > 85) {
      progressClass = 'progress-error';
      badgeClass = 'badge-error text-error-content font-extrabold';
    } else if (percentage > 60) {
      progressClass = 'progress-warning';
      badgeClass = 'badge-warning text-warning-content font-bold';
    }

    const item: CategoryItem = {
      id: cat.id,
      name: cat.name,
      monthlyLimit: limit,
      currentSpent: spent,
      remaining,
      percentage,
      progressClass,
      badgeClass,
      icon: cat.icon || '📌',
      isOcioDanger,
      isHardStopTriggered: !isUntouchable && spent >= limit,
      isUntouchable,
      isPaid: isUntouchable && spent >= limit,
    };

    allCategories.push(item);

    if (isUntouchable) {
      untouchableCommitments.push(item);
      totalUntouchableSpent += spent;
    } else {
      variableCategories.push(item);
      totalVariableSpent += spent;
    }
  }

  // Ordenar compromisos intocables: Maestría primero, luego Deudas
  untouchableCommitments.sort((a, b) => (a.name.toLowerCase().includes('maestr') ? -1 : 1));

  // 2. Transacciones recientes
  const rawTransactions = await db
    .select({
      id: schema.transactions.id,
      amount: schema.transactions.amount,
      description: schema.transactions.description,
      paymentMethod: schema.transactions.payment_method,
      date: schema.transactions.date,
      categoryName: schema.categories.name,
      icon: schema.categories.icon,
    })
    .from(schema.transactions)
    .leftJoin(schema.categories, eq(schema.transactions.category_id, schema.categories.id))
    .orderBy(desc(schema.transactions.date))
    .limit(6);

  recentTransactions = rawTransactions.map((t) => ({
    id: t.id,
    amount: parseFloat(t.amount).toFixed(2),
    description: t.description || 'Gasto registrado',
    paymentMethod: t.paymentMethod || 'DEBITO_EFECTIVO',
    categoryName: t.categoryName || 'General',
    icon: t.icon || '🏷️',
    formattedDate: new Date(t.date).toLocaleDateString('es-HN', {
      day: 'numeric',
      month: 'short',
    }),
  }));
} catch (error) {
  dbConfigured = false;
  // Fallback con datos locales si la BD no responde
  untouchableCommitments = [
    {
      id: 5,
      name: 'Maestría',
      monthlyLimit: 4350.0,
      currentSpent: 0.0,
      remaining: 4350.0,
      percentage: 0,
      progressClass: '',
      badgeClass: '',
      icon: '🎓',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: true,
      isPaid: false,
    },
    {
      id: 6,
      name: 'Deudas/Préstamos Fijos',
      monthlyLimit: 4400.0,
      currentSpent: 0.0,
      remaining: 4400.0,
      percentage: 0,
      progressClass: '',
      badgeClass: '',
      icon: '🏦',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: true,
      isPaid: false,
    },
  ];

  variableCategories = [
    {
      id: 1,
      name: 'Supermercado',
      monthlyLimit: 4000.0,
      currentSpent: 0.0,
      remaining: 4000.0,
      percentage: 0,
      progressClass: 'progress-success',
      badgeClass: 'badge-success text-success-content font-bold',
      icon: '🛒',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: false,
      isPaid: false,
    },
    {
      id: 2,
      name: 'Gasolina',
      monthlyLimit: 2000.0,
      currentSpent: 0.0,
      remaining: 2000.0,
      percentage: 0,
      progressClass: 'progress-success',
      badgeClass: 'badge-success text-success-content font-bold',
      icon: '⛽',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: false,
      isPaid: false,
    },
    {
      id: 3,
      name: 'Ocio y Hormiga',
      monthlyLimit: 1500.0,
      currentSpent: 0.0,
      remaining: 1500.0,
      percentage: 0,
      progressClass: 'progress-success',
      badgeClass: 'badge-success text-success-content font-bold',
      icon: '🐜',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: false,
      isPaid: false,
    },
    {
      id: 4,
      name: 'Software (Vital)',
      monthlyLimit: 1500.0,
      currentSpent: 0.0,
      remaining: 1500.0,
      percentage: 0,
      progressClass: 'progress-success',
      badgeClass: 'badge-success text-success-content font-bold',
      icon: '💻',
      isOcioDanger: false,
      isHardStopTriggered: false,
      isUntouchable: false,
      isPaid: false,
    },
  ];

  allCategories = [...untouchableCommitments, ...variableCategories];
  totalVariableSpent = 0.0;
  totalUntouchableSpent = 0.0;
}

const currentMonthLabel = 'Octubre 2026';

// 🛑 MATEMÁTICA ESTRICTA DE LIQUIDEZ REAL:
// Los L. 8,750 (Maestría 4,350 + Deuda 4,400) se restan automáticamente desde el día 1.
// La liquidez restante real del usuario parte de L. 17,768.00 y se reduce con cada gasto variable.
const initialRealLiquidity = MONTHLY_SALARY - UNTOUCHABLE_COMMITMENTS_TOTAL;
const disposableSalary = initialRealLiquidity - totalVariableSpent;
const totalSpentAll = totalVariableSpent + totalUntouchableSpent;
---

<Layout title="CRONOS - MODO RESCATE (OCTUBRE)">
  <!-- ALERTA DE RESCATE: PÉRDIDA DE PERIODO DE GRACIA -->
  <div class="alert alert-error shadow-xl mb-4 border-2 border-error/50 bg-error/15 text-base-content flex items-start gap-2.5">
    <span class="text-2xl mt-0.5">⚠️</span>
    <div>
      <div class="flex items-center gap-1.5 flex-wrap">
        <h4 class="font-black text-xs uppercase tracking-wider text-error">
          MODO SUPERVIVENCIA ACTIVO
        </h4>
        <span class="badge badge-error text-error-content badge-xs font-black">SIN GRACIA</span>
      </div>
      <p class="text-[11px] font-bold leading-tight mt-0.5">
        Has perdido el periodo de gracia en tus tarjetas este mes. Todo cobro a crédito generará intereses inmediatos. <strong>Usa Débito o Efectivo</strong>.
      </p>
    </div>
  </div>

  <!-- ALERTA PROACTIVA DE DEUDA FIJA (Días 17 al 20) -->
  {isDebtAlertActive && (
    <div class="alert alert-warning shadow-xl mb-4 flex items-start gap-2.5 border-l-4 border-warning text-warning-content animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6 mt-0.5" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <h4 class="font-extrabold text-sm uppercase tracking-wide">¡Compromiso Crítico!</h4>
        <p class="text-xs font-bold leading-snug">
          ¡Atención! Separa L. 4,400 para tarjetas/préstamo el día 20.
        </p>
      </div>
    </div>
  )}

  <!-- CHECKLIST: FUGAS A CORTAR HOY (Suscripciones a cancelar) -->
  <section class="card bg-base-200 border border-error/30 shadow-xl mb-5 overflow-hidden">
    <div class="card-body p-4">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-2">
          <span class="text-xl">✂️</span>
          <div>
            <h3 class="font-black text-sm uppercase tracking-wide text-error">
              Fugas a Cortar Hoy
            </h3>
            <p class="text-[10px] text-base-content/70">
              Marca las suscripciones al cancelarlas para detener fugas:
            </p>
          </div>
        </div>
        <span class="badge badge-error text-error-content font-black text-[10px] py-2">
          $54.98 / mes
        </span>
      </div>

      <div class="divider my-1"></div>

      <div class="space-y-2 mt-0.5" id="leaks-checklist">
        <!-- Item 1 -->
        <label class="flex items-center gap-3 p-2 rounded-xl bg-base-100 border border-base-content/5 cursor-pointer hover:border-error/40 transition-colors">
          <input
            type="checkbox"
            data-leak-id="nanonoble"
            class="checkbox checkbox-error checkbox-sm"
          />
          <div class="flex-1 flex justify-between items-center text-xs">
            <span class="font-bold text-base-content leak-title">Cancelar Nanonoble</span>
            <span class="badge badge-neutral badge-xs font-extrabold text-error">$20.00</span>
          </div>
        </label>

        <!-- Item 2 -->
        <label class="flex items-center gap-3 p-2 rounded-xl bg-base-100 border border-base-content/5 cursor-pointer hover:border-error/40 transition-colors">
          <input
            type="checkbox"
            data-leak-id="appleone"
            class="checkbox checkbox-error checkbox-sm"
          />
          <div class="flex-1 flex justify-between items-center text-xs">
            <span class="font-bold text-base-content leak-title">Cancelar Apple One</span>
            <span class="badge badge-neutral badge-xs font-extrabold text-error">$16.95</span>
          </div>
        </label>

        <!-- Item 3 -->
        <label class="flex items-center gap-3 p-2 rounded-xl bg-base-100 border border-base-content/5 cursor-pointer hover:border-error/40 transition-colors">
          <input
            type="checkbox"
            data-leak-id="amazonprime"
            class="checkbox checkbox-error checkbox-sm"
          />
          <div class="flex-1 flex justify-between items-center text-xs">
            <span class="font-bold text-base-content leak-title">Cancelar Amazon Prime</span>
            <span class="badge badge-neutral badge-xs font-extrabold text-error">$16.04</span>
          </div>
        </label>

        <!-- Item 4 -->
        <label class="flex items-center gap-3 p-2 rounded-xl bg-base-100 border border-base-content/5 cursor-pointer hover:border-error/40 transition-colors">
          <input
            type="checkbox"
            data-leak-id="twitch"
            class="checkbox checkbox-error checkbox-sm"
          />
          <div class="flex-1 flex justify-between items-center text-xs">
            <span class="font-bold text-base-content leak-title">Cancelar Twitch</span>
            <span class="badge badge-neutral badge-xs font-extrabold text-error">$1.99</span>
          </div>
        </label>
      </div>
    </div>
  </section>

  <!-- TARJETA RESUMEN FINANCIERO: SALARIO & CONTROL GLOBAL -->
  <section class="card bg-base-200 border border-base-300 shadow-2xl mb-5 text-base-content overflow-hidden">
    <div class="card-body p-4.5">
      <div class="flex justify-between items-start">
        <div>
          <span class="text-[11px] font-bold tracking-wider text-primary uppercase">Salario Mensual</span>
          <h2 class="text-2xl font-black tracking-tight text-base-content mt-0.5">
            L. {MONTHLY_SALARY.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
          </h2>
        </div>
        <div class="badge badge-primary text-primary-content font-extrabold text-xs py-2 px-2.5">
          {currentMonthLabel}
        </div>
      </div>

      <!-- Métricas Clave con deducción estricta de compromisos intocables -->
      <div class="grid grid-cols-2 gap-2 mt-3 pt-3 border-t border-base-300 text-xs">
        <div class="bg-base-300/80 p-2.5 rounded-xl border border-primary/20">
          <div class="flex items-center justify-between">
            <span class="text-base-content/70 block text-[10px] font-bold">Compromisos Fijos:</span>
            <span class="badge badge-xs badge-neutral text-[9px] font-bold">Congelado</span>
          </div>
          <span class="font-black text-warning text-sm">
            -L. {UNTOUCHABLE_COMMITMENTS_TOTAL.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
          </span>
          <span class="text-[9px] text-base-content/50 block mt-0.5">Maestría + Deuda</span>
        </div>
        <div class="bg-base-300/80 p-2.5 rounded-xl border border-base-content/5">
          <span class="text-base-content/70 block text-[10px] font-bold">Gastos Variables Mes:</span>
          <span class="font-black text-error text-sm">
            L. {totalVariableSpent.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
          </span>
          <span class="text-[9px] text-base-content/50 block mt-0.5">Super, Gas, Ocio, Soft</span>
        </div>
      </div>

      <!-- Saldo Restante Real Automático -->
      <div class="mt-3 text-center text-xs py-2 px-3 rounded-xl border border-primary/30 bg-primary/10 flex flex-col gap-0.5">
        <span class="text-[10px] uppercase font-bold text-base-content/70">
          Liquidez Real Disponible (Te Quedan):
        </span>
        <strong class="text-primary font-black text-lg">
          L. {disposableSalary.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
        </strong>
        <span class="text-[9px] text-base-content/60">
          (Salario L. 26,518 - L. 8,750 Fijos Congelados - L. {totalVariableSpent.toFixed(2)} Variables)
        </span>
      </div>
    </div>
  </section>

  <!-- 🔒 SECCIÓN COMPROMISOS INTOCABLES (MAESTRÍA Y DEUDAS FIJAS) -->
  <section class="card bg-base-200 border-2 border-primary/50 shadow-2xl mb-5 overflow-hidden">
    <div class="card-body p-4.5">
      <div class="flex justify-between items-center mb-1">
        <div class="flex items-center gap-2">
          <span class="text-xl">🔒</span>
          <div>
            <h3 class="font-black text-sm uppercase tracking-wide text-primary">
              Compromisos Intocables
            </h3>
            <p class="text-[10px] text-base-content/70 font-semibold">
              L. 8,750.00 congelados al inicio de cada mes (Checklist Financiero)
            </p>
          </div>
        </div>
        <span class="badge badge-primary text-primary-content text-[10px] font-black py-1 px-2">
          PRIORIDAD MÁXIMA
        </span>
      </div>

      <div class="divider my-1"></div>

      <!-- Tarjetas de Compromisos Intocables (Sin barra de colores, con Checklist/Botón de Pago) -->
      <div class="space-y-3 mt-1">
        {untouchableCommitments.map((cat) => (
          <div
            class={`card border p-3.5 rounded-2xl transition-all shadow-sm ${
              cat.isPaid
                ? 'bg-success/10 border-success/40 text-base-content'
                : 'bg-base-100 border-base-content/15 hover:border-primary/50 text-base-content'
            }`}
          >
            <div class="flex justify-between items-center gap-2">
              <div class="flex items-center gap-3">
                <span class="text-2xl">{cat.icon}</span>
                <div>
                  <h4 class="font-extrabold text-sm text-base-content leading-tight">
                    {cat.name}
                  </h4>
                  <span class="text-xs font-black text-primary block mt-0.5">
                    L. {cat.monthlyLimit.toLocaleString('es-HN', { minimumFractionDigits: 2 })}
                  </span>
                </div>
              </div>

              <!-- Estado de Checklist Financiero: PAGADO vs Botón Registrar Pago -->
              <div>
                {cat.isPaid ? (
                  <div class="flex items-center gap-1.5 bg-success/20 text-success border border-success/40 px-3 py-1.5 rounded-xl font-black text-xs shadow-sm">
                    <span class="text-sm">✓</span>
                    <span>PAGADO</span>
                  </div>
                ) : (
                  <button
                    type="button"
                    class="btn btn-primary btn-sm text-primary-content font-black normal-case text-xs shadow-md btn-pay-commitment"
                    data-cat-id={cat.id}
                    data-cat-name={cat.name}
                    data-cat-amount={cat.monthlyLimit}
                  >
                    <span>Registrar Pago</span>
                  </button>
                )}
              </div>
            </div>

            <!-- Detalle informativo -->
            <div class="mt-2 pt-2 border-t border-base-content/5 flex justify-between items-center text-[10px] text-base-content/60 font-medium">
              <span>
                {cat.isPaid
                  ? `Completado este mes (L. ${cat.currentSpent.toFixed(2)})`
                  : 'Pendiente de registrar en banco'}
              </span>
              <span class="badge badge-ghost badge-xs text-[9px] font-bold">
                Débito Obligatorio
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DASHBOARD DE GASTOS VARIABLES CON BARRAS DE PROGRESO DAISYUI -->
  <section class="mb-6">
    <div class="flex justify-between items-center mb-3">
      <h3 class="font-extrabold text-sm text-base-content flex items-center gap-1.5 uppercase tracking-wide">
        🛡️ Gastos Variables & Bloqueos Duros
      </h3>
      <span class="text-[11px] text-base-content/60 font-semibold">
        {variableCategories.length} Categorías
      </span>
    </div>

    <div class="space-y-3">
      {variableCategories.map((cat) => (
        <div class="card bg-base-200 border border-base-300 shadow-md p-3.5 hover:border-primary/40 transition-all">
          <div class="flex justify-between items-center mb-1.5">
            <div class="flex items-center gap-2">
              <span class="text-lg">{cat.icon}</span>
              <div>
                <span class="font-bold text-sm text-base-content block leading-tight">{cat.name}</span>
                {cat.isOcioDanger && (
                  <span class="badge badge-error text-error-content text-[9px] py-0 px-1.5 font-black animate-pulse">
                    ⚠️ ALERTA: &gt; L. 1,000 Gastados
                  </span>
                )}
              </div>
            </div>
            <span class={`badge badge-sm ${cat.badgeClass}`}>
              {cat.percentage}%
            </span>
          </div>

          <!-- Barra de Progreso DaisyUI con regla Ocio > 1000 en ROJO -->
          <progress
            class={`progress ${cat.progressClass} w-full h-2.5 my-1.5`}
            value={cat.currentSpent}
            max={cat.monthlyLimit}
          ></progress>

          <div class="flex justify-between items-center text-xs text-base-content/70 font-medium mt-0.5">
            <span>Gastado: <strong class="text-base-content font-bold">L. {cat.currentSpent.toFixed(2)}</strong></span>
            <span>Límite: L. {cat.monthlyLimit.toFixed(2)}</span>
          </div>

          {cat.isHardStopTriggered && (
            <div class="text-[10px] text-error font-extrabold mt-1.5 flex items-center gap-1 bg-error/15 p-1.5 rounded-lg border border-error/30">
              🛑 <span>Hard Stop Activo: Límite mensual agotado. Compras bloqueadas.</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Historial Reciente de Gastos -->
  {recentTransactions.length > 0 && (
    <section class="mb-4">
      <h3 class="font-extrabold text-sm text-base-content flex items-center gap-1.5 uppercase tracking-wide mb-2.5">
        ⏱️ Últimos Movimientos
      </h3>
      <div class="space-y-2">
        {recentTransactions.map((item) => (
          <div class="card bg-base-200 border border-base-300 shadow-sm p-3 flex flex-row items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="text-base">{item.icon}</span>
              <div>
                <p class="font-bold text-xs text-base-content leading-tight">{item.description}</p>
                <div class="flex items-center gap-1.5 mt-0.5">
                  <span class="text-[10px] text-base-content/60">{item.categoryName} • {item.formattedDate}</span>
                  {item.paymentMethod === 'TARJETA_CREDITO' ? (
                    <span class="badge badge-error badge-xs text-[8px] font-black py-0 px-1">💳 Crédito</span>
                  ) : (
                    <span class="badge badge-success badge-xs text-[8px] font-black py-0 px-1">💵 Débito</span>
                  )}
                </div>
              </div>
            </div>
            <span class="font-extrabold text-xs text-primary">L. {item.amount}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Floating Action Button (FAB) Fijo Abajo a la Derecha -->
  <button
    id="btn-open-fab"
    type="button"
    class="btn btn-circle btn-primary text-primary-content shadow-2xl fixed bottom-6 right-6 z-40 text-2xl font-black hover:scale-110 active:scale-95 transition-transform"
    title="Registrar Gasto Rápido"
  >
    +
  </button>

  <!-- Dialog / Bottom Sheet Modal de DaisyUI -->
  <dialog id="modal_quick_expense" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box p-5 bg-base-200 border border-base-300 text-base-content max-w-md mx-auto shadow-2xl">
      <div class="flex justify-between items-center mb-3">
        <h3 class="font-black text-base text-base-content flex items-center gap-1.5">
          ⚡ Registrar Gasto Rápido
        </h3>
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost text-base-content/60">✕</button>
        </form>
      </div>

      <form id="cronos-transaction-form" class="space-y-3.5">
        <!-- Input de Número Gigante -->
        <div class="form-control text-center py-1">
          <label class="label-text text-xs text-base-content/60 uppercase font-bold tracking-wider mb-1 block">
            Monto a Registrar
          </label>
          <div class="flex items-center justify-center">
            <span class="text-3xl font-black text-primary mr-1">L.</span>
            <input
              type="number"
              id="quick_amount"
              name="amount"
              step="0.01"
              min="0.01"
              placeholder="0.00"
              required
              class="text-4xl text-center font-black input input-ghost w-48 border-b-2 border-primary focus:outline-none focus:border-primary text-base-content"
            />
          </div>
        </div>

        <!-- Selector de Método de Pago: Bloqueo de Plástico -->
        <div class="form-control">
          <label class="label py-0.5">
            <span class="label-text text-xs font-bold text-base-content">¿Con qué vas a pagar?</span>
          </label>
          <div class="grid grid-cols-2 gap-2">
            <label class="cursor-pointer label border border-base-content/15 rounded-xl p-2 bg-base-100 hover:border-success transition-all has-[:checked]:border-success has-[:checked]:bg-success/10">
              <div class="flex items-center gap-2">
                <input
                  type="radio"
                  name="payment_method"
                  id="pm_debito"
                  value="DEBITO_EFECTIVO"
                  checked
                  class="radio radio-success radio-xs"
                />
                <div class="text-left">
                  <span class="label-text text-xs font-black block text-base-content leading-none">💵 Débito / Efec.</span>
                  <span class="text-[9px] text-success font-bold">Sin interés</span>
                </div>
              </div>
            </label>

            <label class="cursor-pointer label border border-base-content/15 rounded-xl p-2 bg-base-100 hover:border-error transition-all has-[:checked]:border-error has-[:checked]:bg-error/10">
              <div class="flex items-center gap-2">
                <input
                  type="radio"
                  name="payment_method"
                  id="pm_credito"
                  value="TARJETA_CREDITO"
                  class="radio radio-error radio-xs"
                />
                <div class="text-left">
                  <span class="label-text text-xs font-black block text-base-content leading-none">💳 Tarjeta Crédito</span>
                  <span class="text-[9px] text-error font-bold">¡Interés HOY!</span>
                </div>
              </div>
            </label>
          </div>
        </div>

        <!-- Selector de Categorías -->
        <div class="form-control">
          <label class="label py-0.5">
            <span class="label-text text-xs font-bold text-base-content">Categoría</span>
          </label>
          <select id="quick_category_id" name="category_id" required class="select select-bordered select-sm w-full bg-base-100 text-base-content font-semibold">
            <option value="" disabled selected>Selecciona categoría...</option>
            <optgroup label="🔒 Compromisos Intocables">
              {untouchableCommitments.map((c) => (
                <option value={c.id}>
                  {c.icon} {c.name} (L. {c.monthlyLimit.toFixed(2)})
                </option>
              ))}
            </optgroup>
            <optgroup label="🛡️ Gastos Variables">
              {variableCategories.map((c) => (
                <option value={c.id}>
                  {c.icon} {c.name} (Disponible: L. {c.remaining.toFixed(2)})
                </option>
              ))}
            </optgroup>
          </select>
        </div>

        <!-- Descripción -->
        <div class="form-control">
          <label class="label py-0.5">
            <span class="label-text text-xs font-bold text-base-content">Descripción</span>
          </label>
          <input
            type="text"
            id="quick_description"
            name="description"
            placeholder="Ej. Despensa, combustible, colegiatura..."
            class="input input-bordered input-sm w-full bg-base-100 text-base-content font-medium"
          />
        </div>

        <!-- Botón de Envío -->
        <button
          type="submit"
          id="btn-submit-quick"
          class="btn btn-primary text-primary-content btn-block font-extrabold normal-case text-sm mt-2 shadow-lg"
        >
          <span id="btn-quick-text">Aplicar Gasto</span>
          <span id="btn-quick-spinner" class="loading loading-spinner loading-xs hidden"></span>
        </button>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <!-- MODAL DE ADVERTENCIA ROJA: BLOQUEO DE PLÁSTICO (INTERCEPCIÓN) -->
  <dialog id="modal_plastic_warning" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box p-5 bg-base-200 border-2 border-error text-base-content max-w-md mx-auto shadow-2xl">
      <div class="flex items-start gap-3">
        <div class="w-12 h-12 rounded-2xl bg-error/20 text-error flex items-center justify-center text-2xl font-black shrink-0 border border-error/30 animate-pulse">
          🛑
        </div>
        <div>
          <h3 class="font-black text-base text-error uppercase tracking-tight">
            ¡ALTO LUIS!
          </h3>
          <p class="text-xs text-base-content font-bold mt-1.5 leading-relaxed">
            Perdiste tu periodo de gracia este mes. Si pasas la tarjeta por <strong class="text-error font-black text-sm">L. <span id="warning_card_amount">0.00</span></strong>, el banco te cobrará intereses desde HOY. Usa Débito o cancela la compra.
          </p>
        </div>
      </div>

      <div class="divider my-3"></div>

      <div class="flex flex-col gap-2 mt-1">
        <button
          type="button"
          id="btn-plastic-cancel"
          class="btn btn-success text-success-content font-black text-xs normal-case shadow-md"
        >
          ✅ Cambiar a Débito / Efectivo (Recomendado)
        </button>
        <button
          type="button"
          id="btn-plastic-confirm"
          class="btn btn-outline btn-error btn-xs font-bold text-[11px] normal-case opacity-75 hover:opacity-100"
        >
          ⚠️ Confirmar bajo mi propio riesgo
        </button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
</Layout>

<script>
  // Control del Checklist "Fugas a Cortar Hoy" (Persistencia en LocalStorage)
  const checklistContainer = document.getElementById('leaks-checklist');
  const LEAKS_STORAGE_KEY = 'cronos_survival_cancelled_leaks_v1';

  function initChecklist() {
    let savedState: Record<string, boolean> = {};
    try {
      const raw = localStorage.getItem(LEAKS_STORAGE_KEY);
      if (raw) savedState = JSON.parse(raw);
    } catch (e) {
      console.warn('Error leyendo checklist de localStorage');
    }

    const checkboxes = checklistContainer?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
    checkboxes?.forEach((cb) => {
      const leakId = cb.getAttribute('data-leak-id');
      const labelSpan = cb.closest('label')?.querySelector('.leak-title');

      if (leakId && savedState[leakId]) {
        cb.checked = true;
        labelSpan?.classList.add('line-through', 'opacity-50');
      }

      cb.addEventListener('change', () => {
        if (!leakId) return;
        savedState[leakId] = cb.checked;
        try {
          localStorage.setItem(LEAKS_STORAGE_KEY, JSON.stringify(savedState));
        } catch (e) {}

        if (cb.checked) {
          labelSpan?.classList.add('line-through', 'opacity-50');
          showDaisyToast('¡Fuga cancelada! Ahorro mensual asegurado.', false);
        } else {
          labelSpan?.classList.remove('line-through', 'opacity-50');
        }
      });
    });
  }

  initChecklist();

  // Control de Modales y Formulario
  const modalQuick = document.getElementById('modal_quick_expense') as HTMLDialogElement;
  const modalPlastic = document.getElementById('modal_plastic_warning') as HTMLDialogElement;
  const btnOpenFab = document.getElementById('btn-open-fab') as HTMLButtonElement;
  const form = document.getElementById('cronos-transaction-form') as HTMLFormElement;
  const amountInput = document.getElementById('quick_amount') as HTMLInputElement;
  const categorySelect = document.getElementById('quick_category_id') as HTMLSelectElement;
  const descriptionInput = document.getElementById('quick_description') as HTMLInputElement;
  const btnSubmit = document.getElementById('btn-submit-quick') as HTMLButtonElement;
  const btnText = document.getElementById('btn-quick-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-quick-spinner') as HTMLSpanElement;
  const toastContainer = document.getElementById('toast-container') as HTMLDivElement;

  const warningCardAmount = document.getElementById('warning_card_amount') as HTMLSpanElement;
  const btnPlasticCancel = document.getElementById('btn-plastic-cancel') as HTMLButtonElement;
  const btnPlasticConfirm = document.getElementById('btn-plastic-confirm') as HTMLButtonElement;
  const pmDebito = document.getElementById('pm_debito') as HTMLInputElement;
  const pmCredito = document.getElementById('pm_credito') as HTMLInputElement;

  let plasticRiskAccepted = false;

  btnOpenFab?.addEventListener('click', () => {
    modalQuick.showModal();
    plasticRiskAccepted = false;
    setTimeout(() => amountInput?.focus(), 150);
  });

  // Botones de "Registrar Pago" de Compromisos Intocables (Un solo clic)
  const payCommitmentBtns = document.querySelectorAll<HTMLButtonElement>('.btn-pay-commitment');
  payCommitmentBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const catId = parseInt(btn.dataset.catId || '0');
      const catName = btn.dataset.catName || 'Compromiso Fijo';
      const amount = parseFloat(btn.dataset.catAmount || '0');

      if (!catId || isNaN(amount) || amount <= 0) return;

      const confirmed = confirm(
        `¿Confirmas el registro del pago de ${catName} por L. ${amount.toFixed(2)} (vía Débito/Efectivo)?`
      );
      if (!confirmed) return;

      btn.disabled = true;
      btn.innerHTML = `<span class="loading loading-spinner loading-xs"></span> Registrando...`;

      try {
        const response = await fetch('/api/transactions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            amount,
            category_id: catId,
            description: `Pago mensual ${catName}`,
            payment_method: 'DEBITO_EFECTIVO',
          }),
        });

        const data = await response.json();
        if (!response.ok) {
          showDaisyToast(data.error || 'Error al registrar pago', true);
          btn.disabled = false;
          btn.textContent = 'Registrar Pago';
        } else {
          showDaisyToast(`¡${catName} registrado como PAGADO!`, false);
          setTimeout(() => window.location.reload(), 1000);
        }
      } catch (err) {
        showDaisyToast('Error de red al registrar pago.', true);
        btn.disabled = false;
        btn.textContent = 'Registrar Pago';
      }
    });
  });

  // Mostrar Toast Nativo de DaisyUI
  function showDaisyToast(message: string, isError: boolean = false) {
    if (!toastContainer) return;

    const toastDiv = document.createElement('div');
    toastDiv.className = `alert ${isError ? 'alert-error text-error-content' : 'alert-success text-success-content'} shadow-2xl text-xs font-extrabold flex items-center gap-2 pointer-events-auto transition-all animate-bounce border border-base-content/20`;
    toastDiv.innerHTML = `
      <span>${isError ? '🛑' : '✅'}</span>
      <span>${message}</span>
    `;

    toastContainer.appendChild(toastDiv);

    setTimeout(() => {
      toastDiv.classList.remove('animate-bounce');
      toastDiv.classList.add('opacity-0', 'scale-90');
      setTimeout(() => toastDiv.remove(), 300);
    }, 4000);
  }

  // Botón Cancelar del Modal de Plástico -> Cambiar a Débito
  btnPlasticCancel?.addEventListener('click', () => {
    modalPlastic.close();
    if (pmDebito) pmDebito.checked = true;
    plasticRiskAccepted = false;
    showDaisyToast('Método cambiado a Débito/Efectivo para protegerte de intereses.', false);
  });

  // Botón Confirmar del Modal de Plástico -> Proceder bajo propio riesgo
  btnPlasticConfirm?.addEventListener('click', () => {
    plasticRiskAccepted = true;
    modalPlastic.close();
    executeSubmit();
  });

  // Envío del Formulario
  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const amount = parseFloat(amountInput.value);
    const category_id = parseInt(categorySelect.value);

    if (isNaN(amount) || amount <= 0 || isNaN(category_id)) {
      showDaisyToast('Por favor ingresa un monto válido y selecciona una categoría.', true);
      return;
    }

    const selectedPaymentMethod = pmCredito?.checked ? 'TARJETA_CREDITO' : 'DEBITO_EFECTIVO';

    // 🛑 REGLA DE INTERCEPCIÓN: BLOQUEO DE PLÁSTICO
    if (selectedPaymentMethod === 'TARJETA_CREDITO' && !plasticRiskAccepted) {
      if (warningCardAmount) {
        warningCardAmount.textContent = amount.toLocaleString('es-HN', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });
      }
      modalPlastic.showModal();
      return;
    }

    executeSubmit();
  });

  async function executeSubmit() {
    const amount = parseFloat(amountInput.value);
    const category_id = parseInt(categorySelect.value);
    const description = descriptionInput.value.trim();
    const payment_method = pmCredito?.checked ? 'TARJETA_CREDITO' : 'DEBITO_EFECTIVO';

    btnSubmit.disabled = true;
    btnText.textContent = 'Verificando Hard Stop...';
    btnSpinner.classList.remove('hidden');

    try {
      const response = await fetch('/api/transactions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount,
          category_id,
          description,
          payment_method,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        // Bloqueo 400 Bad Request
        showDaisyToast(data.error || 'Límite excedido. Transacción bloqueada.', true);
      } else {
        // HTTP 200: Éxito
        showDaisyToast('Gasto registrado con éxito.', false);
        form.reset();
        plasticRiskAccepted = false;
        modalQuick.close();
        setTimeout(() => window.location.reload(), 1000);
      }
    } catch (err) {
      showDaisyToast('Error de red al registrar la transacción.', true);
    } finally {
      btnSubmit.disabled = false;
      btnText.textContent = 'Aplicar Gasto';
      btnSpinner.classList.add('hidden');
      plasticRiskAccepted = false;
    }
  }
</script>
