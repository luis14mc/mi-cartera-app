---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="forest">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Control CRONOS</title>
    
    <!-- PWA Settings con tema Forest -->
    <meta name="theme-color" content="#181313" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CRONOS" />
    <meta name="application-name" content="Control CRONOS" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-base-300 text-base-content antialiased flex flex-col items-center justify-start sm:py-4">
    <!-- Contenedor Estrictamente Mobile-First (max-w-md) con tema Forest -->
    <div class="w-full max-w-md min-h-screen sm:min-h-[92vh] sm:rounded-3xl flex flex-col bg-base-100 shadow-2xl relative overflow-x-hidden border border-base-content/10">
      
      <!-- Header Mobile-First -->
      <header class="navbar bg-base-100/95 backdrop-blur-md sticky top-0 z-40 border-b border-base-200 px-4 py-2">
        <div class="flex-1 items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-primary text-primary-content flex items-center justify-center font-black shadow-md shadow-primary/20">
            ⏳
          </div>
          <div>
            <h1 class="font-extrabold text-base tracking-tight leading-none text-base-content flex items-center gap-1.5">
              CRONOS
              <span class="badge badge-error text-error-content text-[9px] font-black uppercase tracking-wider py-0.5 px-1.5 animate-pulse">RESCATE</span>
            </h1>
            <span class="text-[10px] text-error font-black uppercase tracking-wider">MODO RESCATE (OCTUBRE)</span>
          </div>
        </div>
        <div class="flex-none gap-2">
          <!-- Avatar del Usuario -->
          <div class="avatar placeholder">
            <div class="bg-neutral text-neutral-content rounded-full w-8 ring-2 ring-primary ring-offset-base-100 ring-offset-1">
              <span class="text-xs font-bold">LU</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Contenido Principal -->
      <main class="flex-1 p-4 pb-28">
        <slot />
      </main>

      <!-- Toast Container Nativo DaisyUI -->
      <div id="toast-container" class="toast toast-top toast-center z-50 pointer-events-none w-full max-w-xs transition-all"></div>
    </div>

    <!-- PWA Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.log('CRONOS ServiceWorker: Activo en modo build/producción', err);
          });
        });
      }
    </script>
  </body>
</html>
