---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="forest">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Control CRONOS</title>
    
    <!-- PWA Settings con tema Forest -->
    <meta name="theme-color" content="#181313" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CRONOS" />
    <meta name="application-name" content="Control CRONOS" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Google Fonts & Material Symbols (Canopy Nocturne Design System) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <style is:global>
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      h1, h2, h3, h4, .font-headline {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-surface-container-lowest text-on-surface antialiased flex flex-col items-center justify-start sm:py-4">
    <!-- Contenedor Estrictamente Mobile-First (max-w-md) con Canopy Nocturne & DaisyUI Forest -->
    <div class="w-full max-w-md min-h-screen sm:min-h-[92vh] sm:rounded-3xl flex flex-col bg-surface shadow-2xl relative overflow-x-hidden border border-outline-variant/30">
      
      <!-- Header Mobile-First Canopy Nocturne -->
      <header class="navbar bg-surface/90 backdrop-blur-xl sticky top-0 z-40 border-b border-outline-variant/20 px-4 py-2.5">
        <div class="flex-1 items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary font-bold shadow-sm shadow-primary/20">
            <span class="material-symbols-outlined text-[19px]">spa</span>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <h1 class="font-extrabold text-base tracking-tight leading-none text-on-surface">CRONOS</h1>
              <span class="badge badge-error text-error-content text-[9px] font-black uppercase tracking-wider py-0.5 px-1.5 animate-pulse">RESCATE</span>
            </div>
            <span class="text-[10px] text-primary font-semibold uppercase tracking-wider block mt-0.5">Modo Supervivencia</span>
          </div>
        </div>
        <div class="flex-none gap-2">
          <!-- Avatar del Usuario -->
          <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary font-bold text-xs shadow-sm">
            <span class="material-symbols-outlined text-[18px]">person</span>
          </div>
        </div>
      </header>

      <!-- Contenido Principal -->
      <main class="flex-1 p-4 pb-28">
        <slot />
      </main>

      <!-- Bottom Navigation Bar (Canopy Nocturne Design System) -->
      <nav class="fixed bottom-0 w-full max-w-md z-40 bg-surface-container-low/95 backdrop-blur-xl border-t border-outline-variant/20 shadow-[0_-1px_12px_rgba(0,0,0,0.4)]">
        <div class="flex justify-around items-center h-16 px-2">
          <a href="/" class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] gap-1 transition-colors text-primary font-semibold">
            <span class="material-symbols-outlined text-[22px]">grid_view</span>
            <span class="text-[11px] font-medium tracking-tight">Dashboard</span>
          </a>
          <a href="#section-expenses" class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] gap-1 text-on-surface-variant hover:text-on-surface transition-colors">
            <span class="material-symbols-outlined text-[22px]">receipt_long</span>
            <span class="text-[11px] font-medium tracking-tight">Gastos</span>
          </a>
          <a href="#section-commitments" class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] gap-1 text-on-surface-variant hover:text-on-surface transition-colors">
            <span class="material-symbols-outlined text-[22px]">payments</span>
            <span class="text-[11px] font-medium tracking-tight">Pagos</span>
          </a>
          <a href="#section-checklist" class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] gap-1 text-on-surface-variant hover:text-on-surface transition-colors">
            <span class="material-symbols-outlined text-[22px]">tune</span>
            <span class="text-[11px] font-medium tracking-tight">Fugas</span>
          </a>
        </div>
      </nav>

      <!-- Toast Container Nativo DaisyUI -->
      <div id="toast-container" class="toast toast-top toast-center z-50 pointer-events-none w-full max-w-xs transition-all"></div>
    </div>

    <!-- PWA Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.log('CRONOS ServiceWorker: Activo en modo build/producción', err);
          });
        });
      }
    </script>
  </body>
</html>
