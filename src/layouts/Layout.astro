---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="cartera">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Mi Cartera</title>
    
    <!-- PWA Primary Color and Meta Tags -->
    <meta name="theme-color" content="#10b981" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Mi Cartera" />
    <meta name="application-name" content="Mi Cartera" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content antialiased flex flex-col items-center">
    <!-- Contenedor Responsivo Mobile-First -->
    <div class="w-full max-w-xl min-h-screen flex flex-col bg-base-100 shadow-2xl relative">
      <!-- Navbar Superior Móvil -->
      <header class="navbar bg-base-100/90 backdrop-blur-md sticky top-0 z-40 border-b border-base-200 px-4">
        <div class="flex-1 items-center gap-2">
          <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black shadow-inner">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M21 7.28V5c0-1.1-.9-2-2-2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-2.28c.59-.35 1-.98 1-1.72V9c0-.74-.41-1.37-1-1.72zM20 9v6h-7V9h7zM5 19V5h14v2h-6c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h6v2H5z"/>
              <circle cx="16" cy="12" r="1.5"/>
            </svg>
          </div>
          <div>
            <h1 class="font-extrabold text-lg tracking-tight leading-none text-neutral">Mi Cartera</h1>
            <span class="text-xs text-base-content/60 font-medium">Control Inteligente</span>
          </div>
        </div>
        <div class="flex-none gap-2">
          <div class="badge badge-primary badge-outline font-semibold text-xs py-2 px-3">
            SSR Vercel
          </div>
        </div>
      </header>

      <!-- Contenido Principal -->
      <main class="flex-1 p-4 pb-24">
        <slot />
      </main>

      <!-- Barra de Estado Inferior / PWA Ready -->
      <footer class="fixed bottom-0 max-w-xl w-full bg-base-100/95 backdrop-blur-md border-t border-base-200 p-2 text-center text-xs text-base-content/60 flex items-center justify-between px-6 z-30">
        <span class="flex items-center gap-1.5 font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-success animate-pulse"></span>
          Neon Postgres Online
        </span>
        <span class="badge badge-ghost badge-sm text-[10px]">v1.0 • PWA Ready</span>
      </footer>
    </div>

    <!-- Script de registro PWA Service Worker -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.log('ServiceWorker registration note: active in production/build mode', err);
          });
        });
      }
    </script>
  </body>
</html>
