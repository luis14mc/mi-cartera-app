# Connection String de Neon PostgreSQL (Neon Serverless Driver)
# Obtén tu connection string desde la consola de Neon (https://console.neon.tech):
# Ejemplo: postgresql://[user]:[password]@[endpoint-id].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:tu_password_aqui@ep-ejemplo.us-east-2.aws.neon.tech/mi-cartera-app?sslmode=require"

# (Opcional) Token secreto para asegurar tus endpoints de Vercel Cron Jobs
CRON_SECRET="mi_secreto_super_seguro_para_cron"
